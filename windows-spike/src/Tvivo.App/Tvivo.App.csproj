<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Keep XAML resource target paths rooted at the intermediate XBF layout for explicit Platform builds. -->
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>Tvivo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Tvivo.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <Configurations>Debug;Release;XamlDiagnostics</Configurations>
    <!-- Select exactly one native asset set for each build; Platform alone is not a .NET RID. -->
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <EnablePreviewMsixTooling>false</EnablePreviewMsixTooling>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged WinUI loads the app resource index from this well-known name. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- LibVLCSharp WinUI requires self-contained unpackaged deployment without auto-bootstrap. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Import Project="..\..\Version.props" />
  <!-- Windows 10 edition (installer\build-msi.ps1 -Win10): same code, lower OS floor. -->
  <PropertyGroup Condition="'$(TvivoWin10)' == 'true'">
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'XamlDiagnostics'">
    <DefineConstants>$(DefineConstants);TVIVO_XAML_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Tvivo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tvivo.Core\Tvivo.Core.csproj" />
    <ProjectReference Include="..\Tvivo.Infrastructure\Tvivo.Infrastructure.csproj" />
    <ProjectReference Include="..\Tvivo.Playback\Tvivo.Playback.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <!-- The Windows SDK PRI targets generate the app PRI but their publish hook does not
       reach the .NET 9 unpackaged publish item list. Add that generated output there. -->
  <Target Name="AddGeneratedProjectPriToPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="_GenerateProjectPriFile">
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(ProjectPriFullPath)" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="'$(CopyBuildOutputToPublishDirectory)' == 'true' and Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
