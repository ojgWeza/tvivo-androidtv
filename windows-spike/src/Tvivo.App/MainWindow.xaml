                            </Grid>
                        </Border>
                        </Grid>
                        <Border x:Name="CompactSleepTimerPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="340" Padding="14" CornerRadius="8" Background="{ThemeResource AppPanelSurfaceBrush}"
                                Visibility="Collapsed" IsHitTestVisible="True">
                            <StackPanel Spacing="8">
                                <StackPanel x:Name="CompactSleepTimerWarningActions" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="Playback stops in 2 minutes" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Button Content="Add 15 minutes" MinHeight="44" FontSize="16"
                                            Style="{StaticResource AppPrimaryButtonStyle}" Click="SleepTimerExtend_Click"
                                            AutomationProperties.Name="Add 15 minutes to sleep timer" />
                                    <Button Content="Turn off timer" MinHeight="44" FontSize="16"
                                            Style="{StaticResource AppQuietButtonStyle}" Click="SleepTimerCancel_Click"
                                            AutomationProperties.Name="Turn off sleep timer" />
                                </StackPanel>
                                <StackPanel x:Name="CompactSleepTimerEndedActions" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="Sleep timer ended" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <Button Content="Back to catalog" MinHeight="44" FontSize="16"
                                            Style="{StaticResource AppPrimaryButtonStyle}" Click="CompactSleepTimerBack_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <local:CompactResizeZone x:Name="CompactResizeEdgeLeft" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="7"
                                                 Edges="Left" CursorShape="SizeWestEast" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeLeft" />
                        <local:CompactResizeZone x:Name="CompactResizeEdgeTop" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="7"
                                                 Edges="Top" CursorShape="SizeNorthSouth" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeTop" />
                        <local:CompactResizeZone x:Name="CompactResizeEdgeRight" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="7"
                                                 Edges="Right" CursorShape="SizeWestEast" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeRight" />
                        <local:CompactResizeZone x:Name="CompactResizeEdgeBottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="7"
                                                 Edges="Bottom" CursorShape="SizeNorthSouth" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeBottom" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerTopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Width="7" Height="7"
                                                 Edges="Left, Top" CursorShape="SizeNorthwestSoutheast" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerTopLeft" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerTopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="7" Height="7"
                                                 Edges="Right, Top" CursorShape="SizeNortheastSouthwest" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerTopRight" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerBottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="7" Height="7"
                                                 Edges="Left, Bottom" CursorShape="SizeNortheastSouthwest" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerBottomLeft" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerBottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="7" Height="7"
                                                 Edges="Right, Bottom" CursorShape="SizeNorthwestSoutheast" Background="Transparent"
                                                 PointerEntered="CompactResizeZone_PointerEntered" PointerExited="CompactResizeZone_PointerExited"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerBottomRight" />
                    </Grid>

                    <StackPanel x:Name="PlayerDetailsPanel" Grid.Row="1" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PlayerTitleText" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" Text="Now playing" VerticalAlignment="Center" />
                            <Button x:Name="PlayerAboutButton" Content="ⓘ" Visibility="Collapsed"
                                    Width="36" Height="36" MinWidth="36" Padding="0"
                                    Style="{StaticResource AppIconButtonStyle}"
                                    AutomationProperties.Name="Show title description">
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Width" Value="380" />
                                                <Setter Property="MaxWidth" Value="380" />
                                                <Setter Property="MaxHeight" Value="340" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <Border Width="360" Height="300" MaxWidth="380" MaxHeight="340" Padding="18"
                                                Background="{ThemeResource AppPanelSurfaceBrush}"
                                                CornerRadius="12">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          HorizontalScrollMode="Disabled">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="ABOUT THIS TITLE" FontSize="12" FontWeight="Bold"
                                                               Foreground="{ThemeResource AppAccentSoftBrush}" />
                                                    <TextBlock x:Name="PlayerAboutText" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource AppTextBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PlayerMetadataLine" Visibility="Collapsed"
                                   Foreground="{ThemeResource AppMutedTextBrush}" FontSize="16"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="NativeCinemaButton"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Cinema mode" ToolTipService.ToolTip="Cinema mode"
                            Visibility="Collapsed"
                            Style="{StaticResource AppIconButtonStyle}"
                            Click="CinemaButton_Click" />

                    <!-- Keep one app-owned transport below both playback surfaces. -->
                    <Border x:Name="VlcTransportBar" Grid.Row="2" Padding="14,10" Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="10">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25" />
                    </Border.OpacityTransition>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseButton" Grid.Column="0" Content="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Pause" ToolTipService.ToolTip="Pause" Style="{StaticResource AppIconButtonStyle}" Click="PauseButton_Click" />
                        <Button x:Name="RewindButton" Grid.Column="2" Style="{StaticResource AppIconButtonStyle}" Click="RewindButton_Click" PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased" PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost" LostFocus="SeekButton_LostFocus" AutomationProperties.Name="Rewind 10 seconds" ToolTipService.ToolTip="Rewind 10 seconds" Content="&#xEB9E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Grid Grid.Column="3" ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" Foreground="{ThemeResource AppMutedTextBrush}" Text="0:00" />
                            <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="ProgressSlider_ValueChanged" PointerPressed="ProgressSlider_PointerPressed" PointerReleased="ProgressSlider_PointerReleased" PointerCaptureLost="ProgressSlider_PointerCaptureLost" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource AppMutedTextBrush}" Text="0:00" />
                        </Grid>
                        <Button x:Name="ForwardButton" Grid.Column="5" Style="{StaticResource AppIconButtonStyle}" Click="ForwardButton_Click" PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased" PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost" LostFocus="SeekButton_LostFocus" AutomationProperties.Name="Forward 10 seconds" ToolTipService.ToolTip="Forward 10 seconds" Content="&#xEB9D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Button x:Name="PreviousEpisodeButton" Grid.Column="1" Content="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Visibility="Collapsed" ToolTipService.ToolTip="Previous episode"
                                Style="{StaticResource AppIconButtonStyle}" Click="PreviousEpisode_Click"
                                AutomationProperties.Name="Previous episode" />
                        <Button x:Name="NextEpisodeButton" Grid.Column="6" Content="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Visibility="Collapsed" ToolTipService.ToolTip="Next episode"
                                Style="{StaticResource AppIconButtonStyle}" Click="NextEpisode_Click"
                                AutomationProperties.Name="Next episode" />
                        <Button x:Name="AudioSubtitlesButton" Grid.Column="7" Content="&#xED1E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource AppIconButtonStyle}" AutomationProperties.Name="Audio and subtitles"
                                ToolTipService.ToolTip="Audio &amp; subtitles">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AudioSubtitlesFlyout" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="VolumeButton" Grid.Column="8" Content="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Volume" ToolTipService.ToolTip="Volume" Style="{StaticResource AppIconButtonStyle}" DoubleTapped="VolumeButton_DoubleTapped">
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top" Opened="VolumeFlyout_Opened" Closed="VolumeFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="4" Padding="6">
                                        <TextBlock x:Name="VolumeStateText" Text="" HorizontalAlignment="Center" AutomationProperties.Name="Volume state" />
                                        <Slider x:Name="VolumeSlider" Orientation="Vertical" Height="110" Margin="3,4" Minimum="0" Maximum="100" Value="100" AutomationProperties.Name="Volume" ValueChanged="VolumeSlider_ValueChanged" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="SleepTimerButton" Grid.Column="9" MinWidth="142" MinHeight="48" Padding="12,6"
                                Style="{StaticResource AppQuietButtonStyle}" AutomationProperties.Name="Sleep timer"
                                ToolTipService.ToolTip="Sleep timer">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="20" VerticalAlignment="Center" />
                                    <TextBlock Text="Sleep timer" FontSize="18" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout x:Name="SleepTimerFlyout" Placement="Top" Closed="SleepTimerFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="8" />
                                            <Setter Property="MinWidth" Value="300" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Grid>
                                    <StackPanel x:Name="SleepTimerChoicesPanel" Spacing="6" MaxWidth="360">
                                        <TextBlock Text="Sleep timer" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}" Margin="8,4" />
                                        <Button Content="Off" Tag="0" Click="SleepTimerPreset_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        <Button Content="15 minutes" Tag="15" Click="SleepTimerPreset_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        <Button Content="30 minutes" Tag="30" Click="SleepTimerPreset_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        <Button Content="45 minutes" Tag="45" Click="SleepTimerPreset_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        <Button Content="60 minutes" Tag="60" Click="SleepTimerPreset_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        <Button Content="90 minutes" Tag="90" Click="SleepTimerPreset_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        <Button x:Name="SleepTimerEndOfItemButton" Content="At the end of this movie"
                                                Click="SleepTimerEndOfItem_Click" Style="{StaticResource AppQuietButtonStyle}"
                                                MinHeight="44" FontSize="18" />
                                        <Button Content="Choose minutes…" Click="SleepTimerChooseMinutes_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                    </StackPanel>
                                    <StackPanel x:Name="SleepTimerArmedPanel" Spacing="6" MaxWidth="360" Visibility="Collapsed">
                                        <TextBlock x:Name="SleepTimerFlyoutStatusText" FontSize="18" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource AppTextBrush}" Margin="8,4" />
                                        <Button Content="Add 15 minutes" Click="SleepTimerExtend_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18"
                                                AutomationProperties.Name="Add 15 minutes to sleep timer" />
                                        <Button Content="Change timer" Click="SleepTimerChange_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        <Button Content="Turn off timer" Click="SleepTimerCancel_Click"
                                                Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18"
                                                AutomationProperties.Name="Turn off sleep timer" />
                                    </StackPanel>
                                    <StackPanel x:Name="SleepTimerCustomPanel" Spacing="10" MaxWidth="360" Visibility="Collapsed">
                                        <TextBlock Text="Choose minutes" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}" />
                                        <NumberBox x:Name="SleepTimerMinutesNumberBox" Header="Minutes" Value="30"
                                                   Minimum="5" Maximum="240" SmallChange="5" SpinButtonPlacementMode="Inline"
                                                   AutomationProperties.Name="Minutes, from 5 to 240 in steps of 5" />
                                        <TextBlock Text="Choose 5 to 240 minutes in steps of 5."
                                                   Foreground="{ThemeResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                            <Button Content="Start timer" Click="SleepTimerCustomStart_Click"
                                                    Style="{StaticResource AppPrimaryButtonStyle}" MinHeight="44" FontSize="18" />
                                            <Button Content="Cancel" Click="SleepTimerCustomCancel_Click"
                                                    Style="{StaticResource AppQuietButtonStyle}" MinHeight="44" FontSize="18" />
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="CinemaButton" Grid.Column="10" Content="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Cinema mode" ToolTipService.ToolTip="Cinema mode" Style="{StaticResource AppIconButtonStyle}" Click="CinemaButton_Click" />
                        <Button x:Name="MiniPlayerButton" Grid.Column="11" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                AutomationProperties.Name="Mini player" AutomationProperties.AutomationId="MiniPlayerButton"
                                ToolTipService.ToolTip="Mini player" Style="{StaticResource AppIconButtonStyle}"
                                Click="MiniPlayerButton_Click" />
                        <Button x:Name="PlaylistToggleButton" Grid.Column="12" Content="&#xE8A0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                AutomationProperties.Name="Hide playlist" AutomationProperties.AutomationId="PlaylistToggleButton"
                                ToolTipService.ToolTip="Hide playlist" Style="{StaticResource AppIconButtonStyle}"
                                Click="PlaylistToggleButton_Click" />
                    </Grid>
                    </Border>
                    </Grid>

                    <Border x:Name="PlayerSidePanel" Grid.Column="1" MinWidth="290" Padding="18" Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PlayerSideTitle" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" Text="More from this folder" TextWrapping="Wrap" />
                                <Button x:Name="SeriesFavoriteButton" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource AppIconButtonStyle}"
                                        Content="☆" Width="40" Height="40" MinWidth="40" MinHeight="40"
                                        FontSize="22" Padding="0" HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" Background="Transparent"
                                        Foreground="{ThemeResource AppMutedTextBrush}"
                                        AutomationProperties.Name="Toggle series favorite"
                                        Click="SeriesFavorite_Click" />
                            <StackPanel x:Name="PlayerPlaylistOptionsRow" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <ToggleButton x:Name="AutoplayNextToggle" Content="&#xE893;"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Style="{StaticResource AppIconToggleButtonStyle}"
                                              AutomationProperties.Name="Autoplay next"
                                              ToolTipService.ToolTip="Autoplay next"
                                              Click="PlaybackModeToggle_Click" />
                                <ToggleButton x:Name="ShuffleToggle" Content="&#xE8B1;"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Style="{StaticResource AppIconToggleButtonStyle}"
                                              AutomationProperties.Name="Shuffle"
                                              ToolTipService.ToolTip="Shuffle"
                                              Click="PlaybackModeToggle_Click" />
                            </StackPanel>
                            </Grid>
                            <TextBlock x:Name="PlayerNowPlayingText" Grid.Row="1" Visibility="Collapsed" />
                            <Grid Grid.Row="2" ColumnSpacing="8" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PlayerSeasonLabel" Visibility="Collapsed"
                                           Foreground="{ThemeResource AppMutedTextBrush}" FontSize="16" />
                                <ComboBox x:Name="PlayerSeasonComboBox" Visibility="Collapsed"
                                          DisplayMemberPath="Name" SelectionChanged="PlayerSeasonComboBox_SelectionChanged"
                                          AutomationProperties.Name="Series season" />
                                <TextBlock x:Name="PlayerSeasonWatchedCount" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="Collapsed" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="16" />
                            </Grid>
                            <ListView x:Name="PlayerRelatedList" Grid.Row="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" SelectionMode="Single" IsItemClickEnabled="True" PointerPressed="PlayerRelatedList_PointerPressed" ItemClick="PlayerRelatedList_ItemClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="MinHeight" Value="44" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0" CornerRadius="8" Background="{Binding BackgroundBrush}">
                                          <Grid>
                                            <Grid ColumnSpacing="8" Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" Foreground="{Binding ForegroundBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding FileSizeText}" FontSize="16" AutomationProperties.Name="{Binding FileSizeAutomationName}"
                                                               Visibility="{Binding FileSizeVisibility}"
                                                               Foreground="{ThemeResource AppMutedTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Tag="{Binding}" Style="{StaticResource AppIconButtonStyle}"
                                                        Width="44" Height="44" MinWidth="44" MinHeight="44"
                                                        FontSize="18" Padding="0" HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Foreground="{Binding FavoriteBrush}" Background="Transparent"
                                                        Visibility="{Binding FavoriteVisibility}"
                                                        AutomationProperties.Name="Toggle favorite"
                                                        Click="PlayerFavorite_Click" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                                                         Visibility="{Binding ProgressVisibility}"
                                                         Foreground="{Binding ProgressBarBrush}" Background="{Binding ProgressTrackBrush}"
                                                         Height="3" MinHeight="3" VerticalAlignment="Bottom"
                                                         Margin="10,0,10,4" IsHitTestVisible="False"
                                                         AutomationProperties.Name="{Binding ProgressAutomationName}" />
                                          </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="CatalogPageArea" Visibility="Collapsed">
                <ContentControl x:Name="CatalogPageHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
        <InfoBar x:Name="WindowInfoBar" Grid.Row="2" Canvas.ZIndex="10"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                 MaxWidth="780" FontSize="20"
                 Severity="Error" IsClosable="False" IsOpen="False"
                 AutomationProperties.LiveSetting="Polite"
                 Message="Theme preference couldn't be saved. This choice will last until Tvivo closes." />
    </Grid>
</Window>
