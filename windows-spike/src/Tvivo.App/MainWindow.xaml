<Window
    x:Class="Tvivo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:local="using:Tvivo.App">
    <Grid x:Name="WindowRoot" Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="WindowChrome" Background="{ThemeResource AppDeepBrush}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" Margin="24,0,16,0" CornerRadius="6"
                    Background="{ThemeResource AppAccentBrush}"
                    VerticalAlignment="Center" IsHitTestVisible="False"
                    AutomationProperties.Name="Tvivo">
                <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                          FontSize="12" Foreground="{ThemeResource AppBrandGlyphBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent"
                  AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="WindowStateButton" Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Click="WindowStateButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Switch to windowed mode"
                        ToolTipService.ToolTip="{x:Null}" />
                <Button x:Name="MinimizeWindowButton" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Click="MinimizeWindowButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Minimize window"
                        ToolTipService.ToolTip="{x:Null}" />
                <Button x:Name="CloseWindowButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Click="CloseWindowButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Close Tvivo"
                        ToolTipService.ToolTip="{x:Null}" />
            </StackPanel>
        </Grid>

        <Border x:Name="MainHeader" Grid.Row="1" Background="{ThemeResource AppDeepBrush}" Padding="42,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="TVIVO"
                           FontSize="22"
                           FontWeight="Bold"
                           CharacterSpacing="80"
                           Foreground="{ThemeResource AppTextBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Tvivo" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="32">
                    <Button x:Name="MyTvivoNavigation"
                            Content="For You"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="MyTvivoNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="MoviesNavigation"
                            Content="Movies"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="MoviesNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="SeriesNavigation"
                            Content="Series"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="SeriesNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="LiveTvNavigation"
                            Content="Live TV"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="LiveTvNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel x:Name="CatalogSearchBar" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="TopSearchButton"
                                Content="&#xE721;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource AppIconButtonStyle}"
                                Click="TopSearchButton_Click"
                                AutomationProperties.Name="Search current catalog"
                                ToolTipService.ToolTip="{x:Null}" />
                        <Border x:Name="TopSearchPill"
                                Width="0"
                                Height="36"
                                Visibility="Collapsed"
                                BorderBrush="{ThemeResource AppLineBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource AppPanelSurfaceBrush}"
                                CornerRadius="18"
                                Padding="12,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          FontSize="13" Foreground="{ThemeResource AppMutedTextBrush}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBox x:Name="TopSearchBox"
                                         Grid.Column="1"
                                         PlaceholderText="Search current catalog"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{ThemeResource AppTextBrush}"
                                         TextChanged="TopSearchBox_TextChanged"
                                         KeyDown="TopSearchBox_KeyDown"
                                         LostFocus="TopSearchBox_LostFocus"
                                         Loaded="TopSearchBox_Loaded"
                                         AutomationProperties.Name="Search current catalog"
                                         ToolTipService.ToolTip="{x:Null}" />
                                <!-- Works without focusing the box: clears the search and closes the pill. -->
                                <Button x:Name="TopSearchCloseButton"
                                        Grid.Column="2"
                                        Content="&#xE711;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="12"
                                        Width="28" Height="28" Padding="0"
                                        MinWidth="0" MinHeight="0"
                                        Margin="0,0,-6,0"
                                        CornerRadius="14"
                                        VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{ThemeResource AppMutedTextBrush}"
                                        Click="TopSearchCloseButton_Click"
                                        AutomationProperties.Name="Clear search and close"
                                        ToolTipService.ToolTip="Clear search" />
                            </Grid>
                        </Border>
                        <Button x:Name="TopSortButton"
                                Content="&#xE8CB;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource AppIconButtonStyle}"
                                AutomationProperties.Name="Sort categories"
                                ToolTipService.ToolTip="{x:Null}">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <RadioMenuFlyoutItem Text="Most visited" Tag="Visited" GroupName="TopSort" IsChecked="True" Click="TopSortItem_Click" />
                                    <RadioMenuFlyoutItem Text="Alphabetical (A-Z)" Tag="AlphabeticalAsc" GroupName="TopSort" Click="TopSortItem_Click" />
                                    <RadioMenuFlyoutItem Text="Alphabetical (Z-A)" Tag="AlphabeticalDesc" GroupName="TopSort" Click="TopSortItem_Click" />
                                    <RadioMenuFlyoutItem Text="Recently added" Tag="RecentlyAdded" GroupName="TopSort" Click="TopSortItem_Click" />
                                    <RadioMenuFlyoutItem Text="Recently updated" Tag="RecentlyUpdated" GroupName="TopSort" Click="TopSortItem_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="TopRefreshButton"
                                Content="&#xE72C;"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource AppIconButtonStyle}"
                                Visibility="Collapsed"
                                Click="TopRefreshButton_Click"
                                AutomationProperties.Name="Refresh catalog" />
                    </StackPanel>
                    <Button x:Name="ThemeToggleButton"
                            Content="&#xE706;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Style="{StaticResource AppIconButtonStyle}"
                            Click="ThemeToggleButton_Click"
                            AutomationProperties.Name="Switch to light theme"
                            ToolTipService.ToolTip="Switch to light theme" />
                    <Button x:Name="AccountNavigation"
                            Content="&#xE713;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            Style="{StaticResource AppIconButtonStyle}"
                            Click="AccountNavigation_Click"
                            AutomationProperties.Name="Settings"
                            ToolTipService.ToolTip="{x:Null}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentSurfaceHost" Grid.Row="2">
            <Grid x:Name="PageHost" />
            <Grid x:Name="PlayerPage" Canvas.ZIndex="2" Visibility="Collapsed" Padding="24" KeyDown="PlayerPage_KeyDown"
                  AutomationProperties.Name="Player" AutomationProperties.AutomationId="CompactPlayerCard">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PlayerNavigationRow" Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="PlayerNavigation" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <Button x:Name="PlayerBackButton" Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}" ToolTipService.ToolTip="Back to catalog"
                            Click="PlayerBackButton_Click" AutomationProperties.Name="Back to catalog" />
                    <Button x:Name="PlayerHomeButton" Content="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}" ToolTipService.ToolTip="Go home"
                            Click="PlayerHomeButton_Click" AutomationProperties.Name="Go home" />
                    <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click"
                            AutomationProperties.Name="Copy diagnostics" />
                    <TextBlock x:Name="CopyDiagnosticsStatus" VerticalAlignment="Center"
                               Foreground="{ThemeResource AppMutedTextBrush}" />
                </StackPanel>
                <Grid x:Name="PlayerLayoutGrid" Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PlayerContentColumn" Width="2.35*" />
                        <ColumnDefinition x:Name="PlayerSideColumn" Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PlayerContentGrid" Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PlayerVideoRow" Height="*" />
                        <RowDefinition x:Name="PlayerDetailsRow" Height="Auto" />
                        <RowDefinition x:Name="PlayerTransportRow" Height="Auto" />
                    </Grid.RowDefinitions>

                    <lvs:VideoView x:Name="VideoView"
                                   Grid.Row="0"
                                   Background="{ThemeResource AppPanelSurfaceBrush}"
                                   PointerPressed="VideoSurface_PointerPressed"
                                   PointerReleased="VideoSurface_PointerReleased"
                                   PointerMoved="VideoSurface_PointerMoved"
                                   Initialized="VideoView_Initialized" />
                    <MediaPlayerElement x:Name="NativePlayerElement"
                                        Grid.Row="0"
                                        AreTransportControlsEnabled="False"
                                        Visibility="Collapsed"
                                        PointerPressed="VideoSurface_PointerPressed"
                                        PointerReleased="VideoSurface_PointerReleased"
                                         PointerMoved="VideoSurface_PointerMoved"
                                         Background="{ThemeResource AppPanelSurfaceBrush}" />
                    <Grid x:Name="PlayerVideoCurtain" Grid.Row="0" Background="Black"
                          Visibility="Collapsed" IsHitTestVisible="False"
                          SizeChanged="PlayerVideoCurtain_SizeChanged">
                        <Grid x:Name="PlayerLoadingArt" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RowSpacing="8" IsHitTestVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Image x:Name="PlayerLoadingPoster" Width="120" Height="180" Stretch="UniformToFill"
                                   Visibility="Collapsed" IsHitTestVisible="False"
                                   AutomationProperties.Name="Movie poster" />
                            <TextBlock x:Name="PlayerLoadingPopcorn" Grid.Row="1" HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Emoji" IsColorFontEnabled="True" FontSize="132"
                                       Foreground="#FFFFFFFF" Text="🍿" IsHitTestVisible="False" />
                            <TextBlock x:Name="PlayerLoadingText" Grid.Row="2" HorizontalAlignment="Center"
                                       Foreground="#FFFFFFFF" FontSize="24" Text="Loading..."
                                       AutomationProperties.Name="Loading" IsHitTestVisible="False" />
                            <ProgressBar x:Name="RecentlyLeftCooldownProgress" Grid.Row="3" Width="420" Height="10"
                                         Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"
                                         Foreground="#FFFFFFFF" Background="#FF555555"
                                         AutomationProperties.Name="Waiting for playback" />
                            <ProgressBar x:Name="PlayerSelectionProgress" Grid.Row="4" Width="420" Height="10"
                                         IsIndeterminate="True" Visibility="Collapsed"
                                         Foreground="#FFFFFFFF" Background="#FF555555"
                                         AutomationProperties.Name="Preparing playback" />
                        </Grid>
                    </Grid>
                    <Border x:Name="SleepTimerStatusPanel" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="20,0,20,36" Padding="14,9" CornerRadius="8" Background="{ThemeResource AppPanelSurfaceBrush}"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="SleepTimerStatusText" Foreground="{ThemeResource AppTextBrush}"
                                   FontSize="18" TextWrapping="Wrap" AutomationProperties.LiveSetting="Off" />
                    </Border>
                    <Border x:Name="PlaybackStatusPanel" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            MaxWidth="720" Margin="24,0,24,24" Padding="14,8" CornerRadius="8"
                            Background="{ThemeResource AppPanelSurfaceBrush}" Visibility="Collapsed">
                        <Grid ColumnSpacing="8" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" VerticalAlignment="Center" MaxWidth="640" FontSize="18"
                                       Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="RetryPlaybackButton" Grid.Column="1" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    Style="{StaticResource AppIconButtonStyle}" Visibility="Collapsed"
                                    MinWidth="44" MinHeight="44"
                                    AutomationProperties.Name="Try again" ToolTipService.ToolTip="Try again"
                                    Click="PlaybackFailureRetry_Click" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SleepTimerAnnouncementText" Grid.Row="0" Width="1" Height="1"
                               Opacity="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" />
                    <Border x:Name="SleepTimerWarningPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="680" Margin="24" Padding="24" CornerRadius="12"
                            Background="{ThemeResource AppPanelSurfaceBrush}" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="SleepTimerWarningText" Text="Playback will stop in 2 minutes"
                                       FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppTextBrush}" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <Button x:Name="SleepTimerWarningExtendButton" Content="Add 15 minutes"
                                        Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="190" MinHeight="52" FontSize="18"
                                        AutomationProperties.Name="Add 15 minutes to sleep timer"
                                        Click="SleepTimerExtend_Click" />
                                <Button x:Name="SleepTimerWarningCancelButton" Content="Turn off timer"
                                        Style="{StaticResource AppQuietButtonStyle}" MinWidth="170" MinHeight="52" FontSize="18"
                                        AutomationProperties.Name="Turn off sleep timer"
                                        Click="SleepTimerCancel_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SleepTimerEndedOverlay" Grid.Row="0" Background="{ThemeResource AppPanelSurfaceBrush}" Visibility="Collapsed"
                            Canvas.ZIndex="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720"
                                    Spacing="18" Padding="32">
                            <TextBlock Text="Sleep timer ended" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextBrush}" TextAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="Playback has stopped." FontSize="20"
                                       Foreground="{ThemeResource AppMutedTextBrush}" TextAlignment="Center" />
                            <StackPanel x:Name="SleepTimerEndedReplayActions" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Spacing="12">
                                <Button x:Name="SleepTimerWatchAgainButton" Content="Watch again"
                                        Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="170" MinHeight="52" FontSize="18"
                                        Click="SleepTimerWatchAgain_Click" />
                                <Button x:Name="SleepTimerWatchChannelButton" Content="Watch this channel"
                                        Style="{StaticResource AppQuietButtonStyle}" MinWidth="190" MinHeight="52" FontSize="18"
                                        Click="SleepTimerWatchAgain_Click" />
                            </StackPanel>
                            <Button x:Name="SleepTimerBackButton" Content="Back to catalog"
                                    Style="{StaticResource AppQuietButtonStyle}" HorizontalAlignment="Center"
                                    MinWidth="190" MinHeight="52" FontSize="18" Click="SleepTimerBack_Click" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="NextEpisodePrompt" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="20" Padding="18,12" CornerRadius="10" Background="{ThemeResource AppPanelSurfaceBrush}"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock x:Name="NextEpisodePromptTitle" VerticalAlignment="Center" Foreground="{ThemeResource AppTextBrush}"
                                       TextWrapping="Wrap" MaxWidth="520" />
                            <Button Content="Play now" Style="{StaticResource AppQuietButtonStyle}" Click="NextEpisodePlayNow_Click" />
                            <Button Content="Cancel" Style="{StaticResource AppQuietButtonStyle}" Click="NextEpisodeCancel_Click" />
                            </StackPanel>
                    </Border>
                    <Border x:Name="PlayerNowNextPanel" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="20" Padding="14,10" MaxWidth="520" CornerRadius="10"
                            Background="{ThemeResource AppPanelSurfaceBrush}"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="PlayerNowText" Foreground="{ThemeResource AppTextBrush}"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="PlayerNowProgress" Height="3" Minimum="0" Maximum="100"
                                         Foreground="{ThemeResource AppAccentBrush}"
                                         Background="{ThemeResource AppMutedTextBrush}"
                                         Visibility="Collapsed" IsHitTestVisible="False" />
                            <TextBlock x:Name="PlayerNextText" Foreground="{ThemeResource AppMutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Cinema mode only: title strip that fades in with the transport overlay. -->
                    <Border x:Name="CinemaTitleStrip" Grid.Row="0" VerticalAlignment="Top" Padding="28,18,28,28"
                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.25" />
                        </Border.OpacityTransition>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CC000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="CinemaTitleText" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppOnMediaTextBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Grid x:Name="CompactChrome" Grid.Row="0" Visibility="Collapsed" IsHitTestVisible="True"
                          PointerMoved="CompactChrome_PointerMoved">
                        <Border x:Name="CompactVideoClickTarget" Grid.Row="1" Background="Transparent"
                                PointerPressed="CompactVideoClickTarget_PointerPressed"
                                PointerMoved="CompactVideoClickTarget_PointerMoved"
                                PointerReleased="CompactVideoClickTarget_PointerReleased"
                                PointerCaptureLost="CompactVideoClickTarget_PointerCaptureLost"
                                AutomationProperties.Name="Mini player video" AutomationProperties.AutomationId="CompactVideoClickTarget" />
                        <Grid x:Name="CompactControlsChrome" IsHitTestVisible="True">
                        <Grid.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.25" />
                        </Grid.OpacityTransition>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="CompactDragRegion" Padding="10" Background="{ThemeResource AppMediaScrimBrush}"
                                PointerEntered="CompactControls_PointerEntered" PointerExited="CompactControls_PointerExited">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CompactTitleText" VerticalAlignment="Center" Foreground="{ThemeResource AppOnMediaTextBrush}"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.Name="Mini player title"
                                           AutomationProperties.AutomationId="CompactTitleText" />
                                <TextBlock x:Name="CompactSleepTimerStatusText" Grid.Column="1" VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppOnMediaMutedBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.Name="Sleep timer status" />
                                <Button x:Name="CompactSleepTimerButton" Grid.Column="2" Content="&#xE823;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                        Style="{StaticResource AppIconButtonStyle}" MinWidth="44" MinHeight="44"
                                        AutomationProperties.Name="Sleep timer" AutomationProperties.AutomationId="CompactSleepTimerButton"
                                        ToolTipService.ToolTip="Sleep timer" Click="CompactSleepTimerButton_Click" />
                                <Button x:Name="CompactExpandButton" Grid.Column="3" Content="&#xE8A7;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                        AutomationProperties.Name="Return to player" AutomationProperties.AutomationId="CompactExpandButton"
                                        ToolTipService.ToolTip="Return to player" Click="CompactExpandButton_Click" />
                                <Button x:Name="CompactCloseButton" Grid.Column="4" Content="&#x25A0;"
                                        FontFamily="Segoe UI Symbol, Segoe UI" Style="{StaticResource AppIconButtonStyle}"
                                        AutomationProperties.Name="Stop playback" AutomationProperties.AutomationId="CompactCloseButton"
                                        ToolTipService.ToolTip="Stop playback" Click="CompactCloseButton_Click" />
                                <Button x:Name="CompactMinimizeButton" Grid.Column="5" Content="&#xE921;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                        AutomationProperties.Name="Minimize" AutomationProperties.AutomationId="CompactMinimizeButton"
                                        ToolTipService.ToolTip="Minimize" Click="CompactMinimizeButton_Click" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Padding="10,6,10,8" Background="{ThemeResource AppMediaScrimBrush}"
                                PointerEntered="CompactControls_PointerEntered" PointerExited="CompactControls_PointerExited">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="CompactSeekRow" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CompactElapsedText" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AppOnMediaTextBrush}" FontSize="11" Text="0:00" />
                                    <Slider x:Name="CompactProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
                                            VerticalAlignment="Center" IsThumbToolTipEnabled="False"
                                            ValueChanged="CompactProgressSlider_ValueChanged"
                                            PointerPressed="CompactProgressSlider_PointerPressed"
                                            PointerReleased="CompactProgressSlider_PointerReleased"
                                            PointerCaptureLost="CompactProgressSlider_PointerCaptureLost"
                                            AutomationProperties.Name="Seek" AutomationProperties.AutomationId="CompactProgressSlider" />
                                    <TextBlock x:Name="CompactDurationText" Grid.Column="2" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AppOnMediaTextBrush}" FontSize="11" Text="0:00" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CompactPreviousButton" Content="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Visibility="Collapsed" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Previous episode" AutomationProperties.AutomationId="CompactPreviousButton"
                                            ToolTipService.ToolTip="Previous episode" Click="PreviousEpisode_Click" />
                                    <Button x:Name="CompactRewindButton" Grid.Column="1" Content="&#xEB9E;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Rewind 10 seconds" ToolTipService.ToolTip="Rewind 10 seconds"
                                            Click="RewindButton_Click"
                                            PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased"
                                            PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost"
                                            LostFocus="SeekButton_LostFocus" />
                                    <Button x:Name="CompactPauseButton" Grid.Column="2" Content="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Style="{StaticResource AppIconButtonStyle}" AutomationProperties.Name="Pause"
                                            AutomationProperties.AutomationId="CompactPlayPauseButton" Click="PauseButton_Click" />
                                    <Button x:Name="CompactForwardButton" Grid.Column="3" Content="&#xEB9D;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Forward 10 seconds" ToolTipService.ToolTip="Forward 10 seconds"
                                            Click="ForwardButton_Click"
                                            PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased"
                                            PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost"
