<Window
    x:Class="Tvivo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows">
    <Grid x:Name="WindowRoot" Background="{StaticResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="WindowChrome" Background="{StaticResource AppDeepBrush}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TVIVO" Margin="24,0,16,0" VerticalAlignment="Center"
                       FontSize="15" FontWeight="Bold" CharacterSpacing="80"
                       Foreground="{StaticResource AppTextBrush}" />
            <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent"
                  AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="WindowStateButton" Content="□" Click="WindowStateButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Switch to windowed mode"
                        ToolTipService.ToolTip="{x:Null}" />
                <Button x:Name="MinimizeWindowButton" Content="—" Click="MinimizeWindowButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Minimize window"
                        ToolTipService.ToolTip="{x:Null}" />
                <Button x:Name="CloseWindowButton" Content="×" Click="CloseWindowButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Close Tvivo"
                        ToolTipService.ToolTip="{x:Null}" />
            </StackPanel>
        </Grid>

        <Border x:Name="MainHeader" Grid.Row="1" Background="{StaticResource AppDeepBrush}" Padding="42,0">
            <Grid ColumnSpacing="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BrandNavigation"
                        Content="TVIVO"
                        Style="{StaticResource AppTopNavButtonStyle}"
                        FontSize="22"
                        FontWeight="Bold"
                        CharacterSpacing="80"
                        Foreground="{StaticResource AppTextBrush}"
                        Click="MyTvivoNavigation_Click"
                        ToolTipService.ToolTip="{x:Null}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="26">
                    <Button x:Name="MyTvivoNavigation"
                            Content="My Tvivo"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="MyTvivoNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="MoviesNavigation"
                            Content="Movies"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="MoviesNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="SeriesNavigation"
                            Content="Series"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="SeriesNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="LiveTvNavigation"
                            Content="Live TV"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="LiveTvNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                </StackPanel>

                <Border Grid.Column="2"
                        MinWidth="230"
                        MaxWidth="320"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource AppLineBrush}"
                        BorderThickness="1"
                        Background="{StaticResource AppPanelSurfaceBrush}"
                        CornerRadius="22"
                        Padding="12,8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TopSearchBox"
                                 Grid.Column="1"
                                 PlaceholderText="Search current catalog"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource AppTextBrush}"
                                 TextChanged="TopSearchBox_TextChanged"
                                 ToolTipService.ToolTip="{x:Null}" />
                        <Button x:Name="TopClearSearchButton"
                                Grid.Column="2"
                                Content="×"
                                Padding="4,0"
                                Visibility="Collapsed"
                                Click="TopClearSearchButton_Click"
                                ToolTipService.ToolTip="{x:Null}" />
                    </Grid>
                </Border>

                <Button x:Name="AccountNavigation"
                        Grid.Column="3"
                        Content="Account"
                        Style="{StaticResource AppTopNavButtonStyle}"
                        Click="AccountNavigation_Click"
                        ToolTipService.ToolTip="{x:Null}" />
                <ComboBox x:Name="PlaybackEngineSelector"
                          Grid.Column="4"
                          MinWidth="150"
                          VerticalAlignment="Center"
                          SelectionChanged="PlaybackEngineSelector_SelectionChanged"
                          AutomationProperties.Name="Playback engine"
                          ToolTipService.ToolTip="{x:Null}">
                    <ComboBoxItem Content="Native player" Tag="Native" />
                    <ComboBoxItem Content="LibVLC" Tag="LibVLC" />
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid x:Name="PageHost" />
            <Grid x:Name="PlayerPage" Visibility="Collapsed" Padding="24" KeyDown="PlayerPage_KeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PlayerNavigationRow" Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="PlayerNavigation" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <Button x:Name="PlayerBackButton" Content="← Back" Style="{StaticResource AppQuietButtonStyle}"
                            Click="PlayerBackButton_Click" AutomationProperties.Name="Back to catalog" />
                    <Button x:Name="PlayerHomeButton" Content="Home" Style="{StaticResource AppQuietButtonStyle}"
                            Click="PlayerHomeButton_Click" AutomationProperties.Name="Go home" />
                </StackPanel>
                <Grid x:Name="PlayerLayoutGrid" Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PlayerContentColumn" Width="2.35*" />
                        <ColumnDefinition x:Name="PlayerSideColumn" Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PlayerContentGrid" Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PlayerVideoRow" Height="*" />
                        <RowDefinition x:Name="PlayerDetailsRow" Height="Auto" />
                        <RowDefinition x:Name="PlayerTransportRow" Height="Auto" />
                    </Grid.RowDefinitions>

                    <lvs:VideoView x:Name="VideoView"
                                   Grid.Row="0"
                                   Background="{StaticResource AppPanelSurfaceBrush}"
                                   PointerPressed="VideoSurface_PointerPressed"
                                   PointerReleased="VideoSurface_PointerReleased"
                                   Initialized="VideoView_Initialized" />
                    <MediaPlayerElement x:Name="NativePlayerElement"
                                        Grid.Row="0"
                                        AreTransportControlsEnabled="False"
                                        Visibility="Collapsed"
                                        PointerPressed="VideoSurface_PointerPressed"
                                        PointerReleased="VideoSurface_PointerReleased"
                                        Background="{StaticResource AppPanelSurfaceBrush}" />
                    <Border x:Name="PlayerVideoCurtain" Grid.Row="0" Background="{StaticResource AppPanelSurfaceBrush}"
                            Visibility="Collapsed" IsHitTestVisible="False" />

                    <StackPanel x:Name="PlayerDetailsPanel" Grid.Row="1" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PlayerTitleText" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Text="Now playing" VerticalAlignment="Center" />
                            <Button x:Name="PlayerAboutButton" Content="ⓘ" Visibility="Collapsed"
                                    Width="36" Height="36" MinWidth="36" Padding="0"
                                    Style="{StaticResource AppIconButtonStyle}"
                                    AutomationProperties.Name="Show title description">
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Width" Value="380" />
                                                <Setter Property="MaxWidth" Value="380" />
                                                <Setter Property="MaxHeight" Value="340" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <Border Width="360" Height="300" MaxWidth="380" MaxHeight="340" Padding="18"
                                                Background="{StaticResource AppPanelSurfaceBrush}"
                                                CornerRadius="12">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          HorizontalScrollMode="Disabled">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="ABOUT THIS TITLE" FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource AppAccentSoftBrush}" />
                                                    <TextBlock x:Name="PlayerAboutText" TextWrapping="Wrap"
                                                               Foreground="{StaticResource AppTextBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PlayerMetadataLine" Visibility="Collapsed"
                                   Foreground="{StaticResource AppMutedTextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource AppMutedTextBrush}" Text="Ready" />
                    </StackPanel>
                    <Button x:Name="NativeCinemaButton"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="Cinema mode"
                            Visibility="Collapsed"
                            Style="{StaticResource AppQuietButtonStyle}"
                            Click="CinemaButton_Click" />

                    <!-- Keep one app-owned transport below both playback surfaces. -->
                    <Border x:Name="VlcTransportBar" Grid.Row="2" Padding="14,10" Background="{StaticResource AppPanelSurfaceBrush}" CornerRadius="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseButton" Grid.Column="0" Content="Pause" Style="{StaticResource AppQuietButtonStyle}" Click="PauseButton_Click" />
                        <Button x:Name="RewindButton" Grid.Column="1" Content="−10s" Style="{StaticResource AppQuietButtonStyle}" Click="RewindButton_Click" AutomationProperties.Name="Rewind 10 seconds" />
                        <Grid Grid.Column="2" ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="0:00" />
                            <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="ProgressSlider_ValueChanged" PointerPressed="ProgressSlider_PointerPressed" PointerReleased="ProgressSlider_PointerReleased" PointerCaptureLost="ProgressSlider_PointerCaptureLost" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="0:00" />
                        </Grid>
                        <Button x:Name="ForwardButton" Grid.Column="3" Content="+10s" Style="{StaticResource AppQuietButtonStyle}" Click="ForwardButton_Click" AutomationProperties.Name="Forward 10 seconds" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="Volume" />
                        <Slider x:Name="VolumeSlider" Grid.Column="5" Width="112" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                        <Button x:Name="CinemaButton" Grid.Column="6" Content="Cinema mode" Style="{StaticResource AppQuietButtonStyle}" Click="CinemaButton_Click" />
                    </Grid>
                    </Border>
                    </Grid>

                    <Border x:Name="PlayerSidePanel" Grid.Column="1" MinWidth="290" Padding="18" Background="{StaticResource AppPanelSurfaceBrush}" CornerRadius="14">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PlayerSideTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Text="More from this folder" TextWrapping="Wrap" />
                                <Button x:Name="SeriesFavoriteButton" Grid.Column="1" Visibility="Collapsed"
                                        Content="☆" Width="40" Height="40" MinWidth="40" MinHeight="40"
                                        FontSize="22" Padding="0" HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" Background="Transparent"
                                        Foreground="{StaticResource AppMutedTextBrush}"
                                        AutomationProperties.Name="Toggle series favorite"
                                        Click="SeriesFavorite_Click" />
                            </Grid>
                            <TextBlock x:Name="PlayerSideSubtitle" Grid.Row="1" Foreground="{StaticResource AppMutedTextBrush}" Text="Other movies in this category" TextWrapping="Wrap" />
                            <TextBlock x:Name="PlayerNowPlayingText" Grid.Row="2" Visibility="Collapsed" />
                            <TextBlock x:Name="PlayerSeasonLabel" Grid.Row="3" Visibility="Collapsed"
                                       Foreground="{StaticResource AppMutedTextBrush}" FontSize="13" />
                            <ComboBox x:Name="PlayerSeasonComboBox" Grid.Row="3" Visibility="Collapsed"
                                      DisplayMemberPath="Name" SelectionChanged="PlayerSeasonComboBox_SelectionChanged"
                                      AutomationProperties.Name="Series season" />
                            <ListView x:Name="PlayerRelatedList" Grid.Row="4" Background="Transparent" BorderThickness="0" SelectionMode="Single" IsItemClickEnabled="True" PointerPressed="PlayerRelatedList_PointerPressed" ItemClick="PlayerRelatedList_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,12" CornerRadius="8" Background="{Binding BackgroundBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding ForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Tag="{Binding}"
                                                        Width="40" Height="40" MinWidth="40" MinHeight="40"
                                                        FontSize="22" Padding="0" HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Foreground="{Binding FavoriteBrush}" Background="Transparent"
                                                        Visibility="{Binding FavoriteVisibility}"
                                                        AutomationProperties.Name="Toggle favorite"
                                                        Click="PlayerFavorite_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="CatalogPageArea" Visibility="Collapsed">
                <ContentControl x:Name="CatalogPageHost" />
            </Grid>
        </Grid>
    </Grid>
</Window>
