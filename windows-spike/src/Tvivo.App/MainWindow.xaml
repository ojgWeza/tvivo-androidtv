<Window
    x:Class="Tvivo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    xmlns:local="using:Tvivo.App">
    <Grid x:Name="WindowRoot" Background="{StaticResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="WindowChrome" Background="{StaticResource AppDeepBrush}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TVIVO" Margin="24,0,16,0" VerticalAlignment="Center"
                       FontSize="15" FontWeight="Bold" CharacterSpacing="80"
                       Foreground="{StaticResource AppTextBrush}" />
            <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent"
                  AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="WindowStateButton" Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Click="WindowStateButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Switch to windowed mode"
                        ToolTipService.ToolTip="{x:Null}" />
                <Button x:Name="MinimizeWindowButton" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Click="MinimizeWindowButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Minimize window"
                        ToolTipService.ToolTip="{x:Null}" />
                <Button x:Name="CloseWindowButton" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Click="CloseWindowButton_Click"
                        Style="{StaticResource AppCaptionButtonStyle}"
                        AutomationProperties.Name="Close Tvivo"
                        ToolTipService.ToolTip="{x:Null}" />
            </StackPanel>
        </Grid>

        <Border x:Name="MainHeader" Grid.Row="1" Background="{StaticResource AppDeepBrush}" Padding="42,0">
            <Grid ColumnSpacing="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BrandNavigation"
                        Content="TVIVO"
                        Style="{StaticResource AppTopNavButtonStyle}"
                        FontSize="22"
                        FontWeight="Bold"
                        CharacterSpacing="80"
                        Foreground="{StaticResource AppTextBrush}"
                        Click="HomeNavigation_Click"
                        ToolTipService.ToolTip="{x:Null}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="26">
                    <Button x:Name="MyTvivoNavigation"
                            Content="My Tvivo"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="MyTvivoNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="MoviesNavigation"
                            Content="Movies"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="MoviesNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="SeriesNavigation"
                            Content="Series"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="SeriesNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                    <Button x:Name="LiveTvNavigation"
                            Content="Live TV"
                            Style="{StaticResource AppTopNavButtonStyle}"
                            Click="LiveTvNavigation_Click"
                            ToolTipService.ToolTip="{x:Null}" />
                </StackPanel>

                <StackPanel x:Name="CatalogSearchBar" Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="320"
                            BorderBrush="{StaticResource AppLineBrush}"
                            BorderThickness="1"
                            Background="{StaticResource AppPanelSurfaceBrush}"
                            CornerRadius="22"
                            Padding="12,8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕"
                                       Foreground="{StaticResource AppMutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="TopSearchBox"
                                     Grid.Column="1"
                                     PlaceholderText="Search current catalog"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource AppTextBrush}"
                                     TextChanged="TopSearchBox_TextChanged"
                                     ToolTipService.ToolTip="{x:Null}" />
                        </Grid>
                    </Border>
                    <ComboBox x:Name="TopSortBox"
                              MinWidth="190"
                              VerticalAlignment="Center"
                              CornerRadius="22"
                              Padding="16,10,8,10"
                              BorderThickness="1"
                              Background="{StaticResource AppPanelSurfaceBrush}"
                              BorderBrush="{StaticResource AppLineBrush}"
                              Foreground="{StaticResource AppTextBrush}"
                              SelectionChanged="TopSortBox_SelectionChanged"
                              AutomationProperties.Name="Sort categories"
                              ToolTipService.ToolTip="{x:Null}">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource AppSurfaceColor}" />
                            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource AppSurfaceColor}" />
                            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource AppSurfaceColor}" />
                            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource AppSurfaceColor}" />
                            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource AppSurfaceColor}" />
                        </ComboBox.Resources>
                        <ComboBoxItem Content="Most visited" Tag="Visited" IsSelected="True" />
                        <ComboBoxItem Content="Alphabetical (A-Z)" Tag="AlphabeticalAsc" />
                        <ComboBoxItem Content="Alphabetical (Z-A)" Tag="AlphabeticalDesc" />
                        <ComboBoxItem Content="Recently added" Tag="RecentlyAdded" />
                        <ComboBoxItem Content="Recently updated" Tag="RecentlyUpdated" />
                    </ComboBox>
                </StackPanel>

                <Button x:Name="AccountNavigation"
                        Grid.Column="3"
                        Content="Settings"
                        Style="{StaticResource AppTopNavButtonStyle}"
                        Click="AccountNavigation_Click"
                        ToolTipService.ToolTip="{x:Null}" />
            </Grid>
        </Border>

        <Grid x:Name="ContentSurfaceHost" Grid.Row="2">
            <Grid x:Name="PageHost" />
            <Grid x:Name="PlayerPage" Canvas.ZIndex="2" Visibility="Collapsed" Padding="24" KeyDown="PlayerPage_KeyDown"
                  AutomationProperties.Name="Player" AutomationProperties.AutomationId="CompactPlayerCard">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PlayerNavigationRow" Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="PlayerNavigation" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <Button x:Name="PlayerBackButton" Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}" ToolTipService.ToolTip="Back to catalog"
                            Click="PlayerBackButton_Click" AutomationProperties.Name="Back to catalog" />
                    <Button x:Name="PlayerHomeButton" Content="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}" ToolTipService.ToolTip="Go home"
                            Click="PlayerHomeButton_Click" AutomationProperties.Name="Go home" />
                    <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click"
                            AutomationProperties.Name="Copy diagnostics" />
                    <TextBlock x:Name="CopyDiagnosticsStatus" VerticalAlignment="Center"
                               Foreground="{StaticResource AppMutedTextBrush}" />
                </StackPanel>
                <Grid x:Name="PlayerLayoutGrid" Grid.Row="1" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PlayerContentColumn" Width="2.35*" />
                        <ColumnDefinition x:Name="PlayerSideColumn" Width="0.9*" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PlayerContentGrid" Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PlayerVideoRow" Height="*" />
                        <RowDefinition x:Name="PlayerDetailsRow" Height="Auto" />
                        <RowDefinition x:Name="PlayerTransportRow" Height="Auto" />
                    </Grid.RowDefinitions>

                    <lvs:VideoView x:Name="VideoView"
                                   Grid.Row="0"
                                   Background="{StaticResource AppPanelSurfaceBrush}"
                                   PointerPressed="VideoSurface_PointerPressed"
                                   PointerReleased="VideoSurface_PointerReleased"
                                   PointerMoved="VideoSurface_PointerMoved"
                                   Initialized="VideoView_Initialized" />
                    <MediaPlayerElement x:Name="NativePlayerElement"
                                        Grid.Row="0"
                                        AreTransportControlsEnabled="False"
                                        Visibility="Collapsed"
                                        PointerPressed="VideoSurface_PointerPressed"
                                        PointerReleased="VideoSurface_PointerReleased"
                                        PointerMoved="VideoSurface_PointerMoved"
                                        Background="{StaticResource AppPanelSurfaceBrush}" />
                    <Border x:Name="PlayerVideoCurtain" Grid.Row="0" Background="{StaticResource AppPanelSurfaceBrush}"
                            Visibility="Collapsed" IsHitTestVisible="False" />
                    <Border x:Name="NextEpisodePrompt" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="20" Padding="18,12" CornerRadius="10" Background="{StaticResource AppPanelSurfaceBrush}"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock x:Name="NextEpisodePromptTitle" VerticalAlignment="Center" Foreground="{StaticResource AppTextBrush}"
                                       TextWrapping="Wrap" MaxWidth="520" />
                            <Button Content="Play now" Style="{StaticResource AppQuietButtonStyle}" Click="NextEpisodePlayNow_Click" />
                            <Button Content="Cancel" Style="{StaticResource AppQuietButtonStyle}" Click="NextEpisodeCancel_Click" />
                            </StackPanel>
                    </Border>
                    <Border x:Name="PlayerNowNextPanel" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="20" Padding="14,10" MaxWidth="520" CornerRadius="10"
                            Background="{StaticResource AppPanelSurfaceBrush}"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="PlayerNowText" Foreground="{StaticResource AppTextBrush}"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="PlayerNowProgress" Height="3" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource AppAccentBrush}"
                                         Background="{StaticResource AppMutedTextBrush}"
                                         Visibility="Collapsed" IsHitTestVisible="False" />
                            <TextBlock x:Name="PlayerNextText" Foreground="{StaticResource AppMutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Cinema mode only: title strip that fades in with the transport overlay. -->
                    <Border x:Name="CinemaTitleStrip" Grid.Row="0" VerticalAlignment="Top" Padding="28,18,28,28"
                            Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.25" />
                        </Border.OpacityTransition>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CC000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="CinemaTitleText" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Grid x:Name="CompactChrome" Grid.Row="0" Visibility="Collapsed" IsHitTestVisible="True"
                          PointerMoved="CompactChrome_PointerMoved">
                        <Border x:Name="CompactVideoClickTarget" Grid.Row="1" Background="Transparent"
                                PointerPressed="CompactVideoClickTarget_PointerPressed"
                                PointerMoved="CompactVideoClickTarget_PointerMoved"
                                PointerReleased="CompactVideoClickTarget_PointerReleased"
                                PointerCaptureLost="CompactVideoClickTarget_PointerCaptureLost"
                                AutomationProperties.Name="Mini player video" AutomationProperties.AutomationId="CompactVideoClickTarget" />
                        <Grid x:Name="CompactControlsChrome" IsHitTestVisible="True">
                        <Grid.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.25" />
                        </Grid.OpacityTransition>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="CompactDragRegion" Padding="10" Background="#CC000000"
                                PointerEntered="CompactControls_PointerEntered" PointerExited="CompactControls_PointerExited">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CompactTitleText" VerticalAlignment="Center" Foreground="White"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.Name="Mini player title"
                                           AutomationProperties.AutomationId="CompactTitleText" />
                                <Button x:Name="CompactExpandButton" Grid.Column="1" Content="&#xE8A7;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                        AutomationProperties.Name="Return to player" AutomationProperties.AutomationId="CompactExpandButton"
                                        ToolTipService.ToolTip="Return to player" Click="CompactExpandButton_Click" />
                                <Button x:Name="CompactCloseButton" Grid.Column="2" Content="&#xE8BB;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                        AutomationProperties.Name="Return to player" AutomationProperties.AutomationId="CompactCloseButton"
                                        ToolTipService.ToolTip="Return to player" Click="CompactCloseButton_Click" />
                                <Button x:Name="CompactMinimizeButton" Grid.Column="3" Content="&#xE921;"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                        AutomationProperties.Name="Minimize" AutomationProperties.AutomationId="CompactMinimizeButton"
                                        ToolTipService.ToolTip="Minimize" Click="CompactMinimizeButton_Click" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Padding="10,6,10,8" Background="#CC000000"
                                PointerEntered="CompactControls_PointerEntered" PointerExited="CompactControls_PointerExited">
                            <Grid RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid x:Name="CompactSeekRow" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CompactElapsedText" VerticalAlignment="Center"
                                               Foreground="White" FontSize="11" Text="0:00" />
                                    <Slider x:Name="CompactProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
                                            VerticalAlignment="Center" IsThumbToolTipEnabled="False"
                                            ValueChanged="CompactProgressSlider_ValueChanged"
                                            PointerPressed="CompactProgressSlider_PointerPressed"
                                            PointerReleased="CompactProgressSlider_PointerReleased"
                                            PointerCaptureLost="CompactProgressSlider_PointerCaptureLost"
                                            AutomationProperties.Name="Seek" AutomationProperties.AutomationId="CompactProgressSlider" />
                                    <TextBlock x:Name="CompactDurationText" Grid.Column="2" VerticalAlignment="Center"
                                               Foreground="White" FontSize="11" Text="0:00" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CompactPreviousButton" Content="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Visibility="Collapsed" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Previous episode" AutomationProperties.AutomationId="CompactPreviousButton"
                                            ToolTipService.ToolTip="Previous episode" Click="PreviousEpisode_Click" />
                                    <Button x:Name="CompactRewindButton" Grid.Column="1" Content="&#xEB9E;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Rewind 10 seconds" ToolTipService.ToolTip="Rewind 10 seconds"
                                            Click="RewindButton_Click"
                                            PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased"
                                            PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost"
                                            LostFocus="SeekButton_LostFocus" />
                                    <Button x:Name="CompactPauseButton" Grid.Column="2" Content="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Style="{StaticResource AppIconButtonStyle}" AutomationProperties.Name="Pause"
                                            AutomationProperties.AutomationId="CompactPlayPauseButton" Click="PauseButton_Click" />
                                    <Button x:Name="CompactForwardButton" Grid.Column="3" Content="&#xEB9D;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Forward 10 seconds" ToolTipService.ToolTip="Forward 10 seconds"
                                            Click="ForwardButton_Click"
                                            PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased"
                                            PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost"
                                            LostFocus="SeekButton_LostFocus" />
                                    <Button x:Name="CompactNextButton" Grid.Column="4" Content="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Visibility="Collapsed" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Next episode" AutomationProperties.AutomationId="CompactNextButton"
                                            ToolTipService.ToolTip="Next episode" Click="NextEpisode_Click" />
                                    <Button x:Name="CompactAudioSubtitlesButton" Grid.Column="6" Content="&#xED1E;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                            Visibility="Collapsed" AutomationProperties.Name="Audio and subtitles"
                                            AutomationProperties.AutomationId="CompactAudioSubtitlesButton"
                                            ToolTipService.ToolTip="Audio &amp; subtitles">
                                        <Button.Flyout>
                                            <MenuFlyout x:Name="CompactAudioSubtitlesFlyout" />
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="CompactMuteButton" Grid.Column="7" Content="&#xE767;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                            AutomationProperties.Name="Mute" AutomationProperties.AutomationId="CompactMuteButton"
                                            ToolTipService.ToolTip="Mute" Click="ToggleMute_Click" />
                                    <Slider x:Name="CompactVolumeSlider" Grid.Column="8" Width="80" Minimum="0" Maximum="100" Value="100"
                                            VerticalAlignment="Center" IsThumbToolTipEnabled="False"
                                            ValueChanged="CompactVolumeSlider_ValueChanged"
                                            AutomationProperties.Name="Volume" AutomationProperties.AutomationId="CompactVolumeSlider" />
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>
                        <local:CompactResizeZone x:Name="CompactResizeEdgeLeft" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="7"
                                                 Edges="Left" CursorShape="SizeWestEast" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeLeft" />
                        <local:CompactResizeZone x:Name="CompactResizeEdgeTop" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="7"
                                                 Edges="Top" CursorShape="SizeNorthSouth" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeTop" />
                        <local:CompactResizeZone x:Name="CompactResizeEdgeRight" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="7"
                                                 Edges="Right" CursorShape="SizeWestEast" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeRight" />
                        <local:CompactResizeZone x:Name="CompactResizeEdgeBottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="7"
                                                 Edges="Bottom" CursorShape="SizeNorthSouth" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeEdgeBottom" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerTopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Width="7" Height="7"
                                                 Edges="Left, Top" CursorShape="SizeNorthwestSoutheast" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerTopLeft" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerTopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="7" Height="7"
                                                 Edges="Right, Top" CursorShape="SizeNortheastSouthwest" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerTopRight" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerBottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="7" Height="7"
                                                 Edges="Left, Bottom" CursorShape="SizeNortheastSouthwest" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerBottomLeft" />
                        <local:CompactResizeZone x:Name="CompactResizeCornerBottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="7" Height="7"
                                                 Edges="Right, Bottom" CursorShape="SizeNorthwestSoutheast" Background="Transparent"
                                                 AutomationProperties.Name="Resize mini player" AutomationProperties.AutomationId="CompactResizeCornerBottomRight" />
                    </Grid>

                    <StackPanel x:Name="PlayerDetailsPanel" Grid.Row="1" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PlayerTitleText" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Text="Now playing" VerticalAlignment="Center" />
                            <Button x:Name="PlayerAboutButton" Content="ⓘ" Visibility="Collapsed"
                                    Width="36" Height="36" MinWidth="36" Padding="0"
                                    Style="{StaticResource AppIconButtonStyle}"
                                    AutomationProperties.Name="Show title description">
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Width" Value="380" />
                                                <Setter Property="MaxWidth" Value="380" />
                                                <Setter Property="MaxHeight" Value="340" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <Border Width="360" Height="300" MaxWidth="380" MaxHeight="340" Padding="18"
                                                Background="{StaticResource AppPanelSurfaceBrush}"
                                                CornerRadius="12">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          HorizontalScrollMode="Disabled">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="ABOUT THIS TITLE" FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource AppAccentSoftBrush}" />
                                                    <TextBlock x:Name="PlayerAboutText" TextWrapping="Wrap"
                                                               Foreground="{StaticResource AppTextBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PlayerMetadataLine" Visibility="Collapsed"
                                   Foreground="{StaticResource AppMutedTextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource AppMutedTextBrush}" Text="Ready" />
                    </StackPanel>
                    <Button x:Name="NativeCinemaButton"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Cinema mode" ToolTipService.ToolTip="Cinema mode"
                            Visibility="Collapsed"
                            Style="{StaticResource AppIconButtonStyle}"
                            Click="CinemaButton_Click" />

                    <!-- Keep one app-owned transport below both playback surfaces. -->
                    <Border x:Name="VlcTransportBar" Grid.Row="2" Padding="14,10" Background="{StaticResource AppPanelSurfaceBrush}" CornerRadius="10"
                            PointerEntered="VlcTransportBar_PointerEntered" PointerExited="VlcTransportBar_PointerExited">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25" />
                    </Border.OpacityTransition>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PauseButton" Grid.Column="0" Content="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Pause" ToolTipService.ToolTip="Pause" Style="{StaticResource AppIconButtonStyle}" Click="PauseButton_Click" />
                        <Button x:Name="RewindButton" Grid.Column="2" Style="{StaticResource AppIconButtonStyle}" Click="RewindButton_Click" PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased" PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost" LostFocus="SeekButton_LostFocus" AutomationProperties.Name="Rewind 10 seconds" ToolTipService.ToolTip="Rewind 10 seconds" Content="&#xEB9E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Grid Grid.Column="3" ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElapsedText" VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="0:00" />
                            <Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="ProgressSlider_ValueChanged" PointerPressed="ProgressSlider_PointerPressed" PointerReleased="ProgressSlider_PointerReleased" PointerCaptureLost="ProgressSlider_PointerCaptureLost" />
                            <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" Text="0:00" />
                        </Grid>
                        <Button x:Name="ForwardButton" Grid.Column="4" Style="{StaticResource AppIconButtonStyle}" Click="ForwardButton_Click" PointerPressed="SeekButton_PointerPressed" PointerReleased="SeekButton_PointerReleased" PointerExited="SeekButton_PointerExited" PointerCaptureLost="SeekButton_PointerCaptureLost" LostFocus="SeekButton_LostFocus" AutomationProperties.Name="Forward 10 seconds" ToolTipService.ToolTip="Forward 10 seconds" Content="&#xEB9D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Button x:Name="PreviousEpisodeButton" Grid.Column="1" Content="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Visibility="Collapsed" ToolTipService.ToolTip="Previous episode"
                                Style="{StaticResource AppIconButtonStyle}" Click="PreviousEpisode_Click"
                                AutomationProperties.Name="Previous episode" />
                        <Button x:Name="NextEpisodeButton" Grid.Column="5" Content="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Visibility="Collapsed" ToolTipService.ToolTip="Next episode"
                                Style="{StaticResource AppIconButtonStyle}" Click="NextEpisode_Click"
                                AutomationProperties.Name="Next episode" />
                        <Button x:Name="AudioSubtitlesButton" Grid.Column="6" Content="&#xED1E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Style="{StaticResource AppIconButtonStyle}" AutomationProperties.Name="Audio and subtitles"
                                ToolTipService.ToolTip="Audio &amp; subtitles">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AudioSubtitlesFlyout" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="VolumeButton" Grid.Column="7" Content="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Volume" ToolTipService.ToolTip="Volume" Style="{StaticResource AppIconButtonStyle}" DoubleTapped="VolumeButton_DoubleTapped">
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top" Opened="VolumeFlyout_Opened" Closed="VolumeFlyout_Closed">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="4" Padding="6">
                                        <TextBlock x:Name="VolumeStateText" Text="" HorizontalAlignment="Center" AutomationProperties.Name="Volume state" />
                                        <Slider x:Name="VolumeSlider" Orientation="Vertical" Height="110" Margin="3,4" Minimum="0" Maximum="100" Value="100" AutomationProperties.Name="Volume" ValueChanged="VolumeSlider_ValueChanged" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="CinemaButton" Grid.Column="8" Content="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="Cinema mode" ToolTipService.ToolTip="Cinema mode" Style="{StaticResource AppIconButtonStyle}" Click="CinemaButton_Click" />
                        <Button x:Name="MiniPlayerButton" Grid.Column="9" Content="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                AutomationProperties.Name="Mini player" AutomationProperties.AutomationId="MiniPlayerButton"
                                ToolTipService.ToolTip="Mini player" Style="{StaticResource AppIconButtonStyle}"
                                Click="MiniPlayerButton_Click" />
                    </Grid>
                    </Border>
                    </Grid>

                    <Border x:Name="PlayerSidePanel" Grid.Column="1" MinWidth="290" Padding="18" Background="{StaticResource AppPanelSurfaceBrush}" CornerRadius="14">
                        <Grid>
                            <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PlayerSideTitle" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Text="More from this folder" TextWrapping="Wrap" />
                                <Button x:Name="SeriesFavoriteButton" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource AppIconButtonStyle}"
                                        Content="☆" Width="40" Height="40" MinWidth="40" MinHeight="40"
                                        FontSize="22" Padding="0" HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center" Background="Transparent"
                                        Foreground="{StaticResource AppMutedTextBrush}"
                                        AutomationProperties.Name="Toggle series favorite"
                                        Click="SeriesFavorite_Click" />
                            <StackPanel x:Name="PlayerPlaylistOptionsRow" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <ToggleButton x:Name="AutoplayNextToggle" Content="&#xE893;"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Style="{StaticResource AppIconToggleButtonStyle}"
                                              AutomationProperties.Name="Autoplay next"
                                              ToolTipService.ToolTip="Autoplay next"
                                              Checked="AutoplayNextToggle_Checked" Unchecked="AutoplayNextToggle_Unchecked" />
                                <ToggleButton x:Name="ShuffleToggle" Content="&#xE8B1;"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Style="{StaticResource AppIconToggleButtonStyle}"
                                              AutomationProperties.Name="Shuffle"
                                              ToolTipService.ToolTip="Shuffle"
                                              Checked="ShuffleToggle_Checked" Unchecked="ShuffleToggle_Unchecked" />
                            </StackPanel>
                            </Grid>
                            <TextBlock x:Name="PlayerSideSubtitle" Grid.Row="1" Margin="0,4,0,0" Foreground="{StaticResource AppMutedTextBrush}" Text="Other movies in this category" TextWrapping="Wrap" />
                            <TextBlock x:Name="PlayerNowPlayingText" Grid.Row="2" Visibility="Collapsed" />
                            <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PlayerSeasonLabel" Visibility="Collapsed"
                                           Foreground="{StaticResource AppMutedTextBrush}" FontSize="13" />
                                <ComboBox x:Name="PlayerSeasonComboBox" Visibility="Collapsed"
                                          DisplayMemberPath="Name" SelectionChanged="PlayerSeasonComboBox_SelectionChanged"
                                          AutomationProperties.Name="Series season" />
                                <TextBlock x:Name="PlayerSeasonWatchedCount" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="Collapsed" Foreground="{StaticResource AppMutedTextBrush}" FontSize="12" />
                            </Grid>
                            <ListView x:Name="PlayerRelatedList" Grid.Row="4" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" SelectionMode="Single" IsItemClickEnabled="True" PointerPressed="PlayerRelatedList_PointerPressed" ItemClick="PlayerRelatedList_ItemClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0" CornerRadius="8" Background="{Binding BackgroundBrush}">
                                          <Grid>
                                            <Grid ColumnSpacing="8" Margin="10,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" Foreground="{Binding ForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Tag="{Binding}" Style="{StaticResource AppIconButtonStyle}"
                                                        Width="32" Height="32" MinWidth="32" MinHeight="32"
                                                        FontSize="18" Padding="0" HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Foreground="{Binding FavoriteBrush}" Background="Transparent"
                                                        Visibility="{Binding FavoriteVisibility}"
                                                        AutomationProperties.Name="Toggle favorite"
                                                        Click="PlayerFavorite_Click" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                                                         Visibility="{Binding ProgressVisibility}"
                                                         Foreground="{Binding ProgressBarBrush}" Background="#33FFFFFF"
                                                         Height="3" MinHeight="3" VerticalAlignment="Bottom"
                                                         Margin="10,0,10,4" IsHitTestVisible="False"
                                                         AutomationProperties.Name="{Binding ProgressAutomationName}" />
                                          </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="CatalogPageArea" Visibility="Collapsed">
                <ContentControl x:Name="CatalogPageHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</Window>
