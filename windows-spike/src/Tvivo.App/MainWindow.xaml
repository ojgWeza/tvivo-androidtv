<Window
    x:Class="Tvivo.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tvivo.App.Controls"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows">
    <Grid Background="{StaticResource AppCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource AppPanelSurfaceBrush}" Padding="18,24">
            <Grid RowSpacing="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="{StaticResource AppTextBrush}"
                           FontSize="22"
                           FontWeight="Bold"
                           Text="tvivo" />
                <StackPanel Grid.Row="1" Spacing="8">
                    <controls:ShellNavigationButton x:Name="HomeNavigation"
                                                    Label="Home"
                                                    Clicked="HomeNavigation_Clicked" />
                    <controls:ShellNavigationButton x:Name="PlayerNavigation"
                                                    Label="Player"
                                                    Clicked="PlayerNavigation_Clicked" />
                    <controls:ShellNavigationButton x:Name="CatalogNavigation"
                                                    Label="Catalog"
                                                    Clicked="CatalogNavigation_Clicked" />
                </StackPanel>
                <TextBlock Grid.Row="2"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           FontSize="12"
                           Text="TVIVO · PREVIEW" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost" />
            <Grid x:Name="PlayerPage" Visibility="Collapsed" Padding="24">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <lvs:VideoView x:Name="VideoView"
                                   Grid.Row="0"
                                   Background="{StaticResource AppPanelSurfaceBrush}"
                                   Initialized="VideoView_Initialized" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <TextBox x:Name="PathBox"
                                 Width="520"
                                 PlaceholderText="Enter a local media path or URI" />
                        <Button Content="Play" Click="Play_Click" />
                        <Button Content="Stop" Click="Stop_Click" />
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppTextBrush}"
                                   Text="Ready" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="CatalogPageArea" Visibility="Collapsed">
                <ContentControl x:Name="CatalogPageHost" />
            </Grid>
        </Grid>
    </Grid>
</Window>
