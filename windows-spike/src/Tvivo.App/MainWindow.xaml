                                            ToolTipService.ToolTip="Next episode" Click="NextEpisode_Click" />
                                    <Button x:Name="CompactAudioSubtitlesButton" Grid.Column="6" Content="&#xED1E;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource AppIconButtonStyle}"
                                            Visibility="Collapsed" AutomationProperties.Name="Audio and subtitles"
                                            AutomationProperties.AutomationId="CompactAudioSubtitlesButton"
