                                    <Button x:Name="CompactNextButton" Grid.Column="4" Content="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Visibility="Collapsed" Style="{StaticResource AppIconButtonStyle}"
