            <!-- Atkinson Hyperlegible Next (SIL OFL, Assets/Fonts/OFL.txt): letterforms designed for low-vision and
                 distance reading. The theme resource covers every control; the implicit style covers bare TextBlocks.
                 Icon glyphs keep their explicit Segoe Fluent Icons FontFamily. -->
            <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/AtkinsonHyperlegibleNext-Regular.ttf#Atkinson Hyperlegible Next</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/AtkinsonHyperlegibleNext-Regular.ttf#Atkinson Hyperlegible Next</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
            <Style x:Key="ShellNavigationButtonStyle" TargetType="Button">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AppMutedTextBrush}" />
            </Style>
            <Style x:Key="AppPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AppOnAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="AppQuietButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="AppShelfTitleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
