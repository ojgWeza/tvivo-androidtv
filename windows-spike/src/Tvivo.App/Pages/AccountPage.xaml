<UserControl
    x:Class="Tvivo.App.Pages.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="52,24" Background="{ThemeResource AppCanvasBrush}">
        <StackPanel MaxWidth="780" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="28">
                <Button x:Name="LibraryTabButton" Content="Library" Tag="Library"
                        Style="{StaticResource AppTopNavButtonStyle}" Padding="0,10,0,8"
                        FontSize="16"
                        Click="SettingsTab_Click" />
                <Button x:Name="ForYouTabButton" Content="For You" Tag="ForYou"
                        Style="{StaticResource AppTopNavButtonStyle}" Padding="0,10,0,8"
                        FontSize="16"
                        Click="SettingsTab_Click" />
                <Button x:Name="PlayerTabButton" Content="Player" Tag="Player"
                        Style="{StaticResource AppTopNavButtonStyle}" Padding="0,10,0,8"
                        FontSize="16"
                        Click="SettingsTab_Click" />
                <Button x:Name="AccountTabButton" Content="Account" Tag="Account"
                        Style="{StaticResource AppTopNavButtonStyle}" Padding="0,10,0,8"
                        FontSize="16"
                        Click="SettingsTab_Click" />
            </StackPanel>

            <StackPanel x:Name="AccountTabPanel" Spacing="14" Visibility="Collapsed">
                <Border Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="16" Padding="24">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Signed in as" />
                            <TextBlock x:Name="DisplayNameText" Foreground="{ThemeResource AppTextBrush}" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Username" />
                            <TextBlock x:Name="UsernameText" Foreground="{ThemeResource AppTextBrush}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Server" />
                            <TextBlock x:Name="ServerText" Foreground="{ThemeResource AppTextBrush}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Max connections" />
                            <TextBlock x:Name="MaxConnectionsText" Foreground="{ThemeResource AppTextBrush}" FontSize="18" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Subscription expiry" />
                            <TextBlock x:Name="ExpiryText" FontSize="18" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SignOutButton" Style="{StaticResource AppQuietButtonStyle}"
                            FontSize="16" Content="Sign out" Click="SignOutButton_Click" />
                    <Button x:Name="ChangeUserButton" Style="{StaticResource AppQuietButtonStyle}"
                            FontSize="16" Content="Change user" Click="ChangeUserButton_Click" />
                </StackPanel>
                <Button Content="Save diagnostics for support" MinHeight="48" MinWidth="280"
                        Style="{StaticResource AppQuietButtonStyle}" Click="SaveDiagnostics_Click" />
                <TextBlock x:Name="DiagnosticsStatusText" FontSize="16" TextWrapping="Wrap"
                           Foreground="{ThemeResource AppMutedTextBrush}" />
            </StackPanel>

            <StackPanel x:Name="ForYouTabPanel" Visibility="Collapsed">
                <Border Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="16" Padding="24">
                    <StackPanel Spacing="10">
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" TextWrapping="Wrap"
                                   Text="Choose which shelves appear on For You and the order they show in." />
                        <StackPanel x:Name="ForYouShelfList" Spacing="4" />
                        <Button Style="{StaticResource AppQuietButtonStyle}" FontSize="16"
                                HorizontalAlignment="Left" Content="Reset to default"
                                Click="ResetForYouLayout_Click" />
                        <Border BorderBrush="{ThemeResource AppMutedTextBrush}" BorderThickness="0,1,0,0"
                                Margin="0,8,0,0" Padding="0,12,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Foreground="{ThemeResource AppTextBrush}" FontSize="20"
                                           FontWeight="SemiBold" Text="Spotlight" />
                                <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="16"
                                           TextWrapping="Wrap"
                                           Text="My Tvivo mixes Movies and Series using these settings evenly." />

                                <TextBlock Foreground="{ThemeResource AppTextBrush}" FontSize="18"
                                           FontWeight="SemiBold" Text="Movies" />
                                <ComboBox x:Name="SpotlightMoviesModeSelector" FontSize="16" MinHeight="44"
                                          SelectionChanged="SpotlightMoviesModeSelector_SelectionChanged"
                                          AutomationProperties.Name="Movies Spotlight source">
                                    <ComboBoxItem Content="Recently added" Tag="RecentlyAdded" />
                                    <ComboBoxItem Content="Specific folders" Tag="SpecificFolders" />
                                    <ComboBoxItem Content="Folders I haven't explored" Tag="UnexploredFolders" />
                                </ComboBox>
                                <StackPanel x:Name="SpotlightMoviesFoldersPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBox x:Name="SpotlightMoviesSearchBox" FontSize="16" MinHeight="44"
                                             PlaceholderText="Search movie folders"
                                             AutomationProperties.Name="Search movie folders"
                                             TextChanged="SpotlightMoviesSearchBox_TextChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SpotlightMoviesSelectAllButton" Content="Select all"
                                                FontSize="16" MinHeight="44" Style="{StaticResource AppQuietButtonStyle}"
                                                AutomationProperties.Name="Select all movie folders"
                                                Click="SpotlightMoviesSelectAllButton_Click" />
                                        <Button x:Name="SpotlightMoviesClearButton" Content="Clear"
                                                FontSize="16" MinHeight="44" Style="{StaticResource AppQuietButtonStyle}"
                                                AutomationProperties.Name="Clear selected movie folders"
                                                Click="SpotlightMoviesClearButton_Click" />
                                        <TextBlock x:Name="SpotlightMoviesSelectedCountText" FontSize="16"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="SpotlightMoviesFolderList" Spacing="4" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="SpotlightMoviesEmptyText" Foreground="{ThemeResource AppMutedTextBrush}"
                                               FontSize="16" TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="No movie folders match this search." />
                                </StackPanel>
                                <TextBlock x:Name="SpotlightMoviesPreviewText" Foreground="{ThemeResource AppMutedTextBrush}"
                                           FontSize="16" TextWrapping="Wrap" />

                                <TextBlock Foreground="{ThemeResource AppTextBrush}" FontSize="18"
                                           FontWeight="SemiBold" Text="Series" />
                                <ComboBox x:Name="SpotlightSeriesModeSelector" FontSize="16" MinHeight="44"
                                          SelectionChanged="SpotlightSeriesModeSelector_SelectionChanged"
                                          AutomationProperties.Name="Series Spotlight source">
                                    <ComboBoxItem Content="Recently added" Tag="RecentlyAdded" />
                                    <ComboBoxItem Content="Specific folders" Tag="SpecificFolders" />
                                    <ComboBoxItem Content="Folders I haven't explored" Tag="UnexploredFolders" />
                                </ComboBox>
                                <StackPanel x:Name="SpotlightSeriesFoldersPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBox x:Name="SpotlightSeriesSearchBox" FontSize="16" MinHeight="44"
                                             PlaceholderText="Search series folders"
                                             AutomationProperties.Name="Search series folders"
                                             TextChanged="SpotlightSeriesSearchBox_TextChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SpotlightSeriesSelectAllButton" Content="Select all"
                                                FontSize="16" MinHeight="44" Style="{StaticResource AppQuietButtonStyle}"
                                                AutomationProperties.Name="Select all series folders"
                                                Click="SpotlightSeriesSelectAllButton_Click" />
                                        <Button x:Name="SpotlightSeriesClearButton" Content="Clear"
                                                FontSize="16" MinHeight="44" Style="{StaticResource AppQuietButtonStyle}"
                                                AutomationProperties.Name="Clear selected series folders"
                                                Click="SpotlightSeriesClearButton_Click" />
                                        <TextBlock x:Name="SpotlightSeriesSelectedCountText" FontSize="16"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource AppMutedTextBrush}" />
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="SpotlightSeriesFolderList" Spacing="4" />
                                    </ScrollViewer>
                                    <TextBlock x:Name="SpotlightSeriesEmptyText" Foreground="{ThemeResource AppMutedTextBrush}"
                                               FontSize="16" TextWrapping="Wrap" Visibility="Collapsed"
                                               Text="No series folders match this search." />
                                </StackPanel>
                                <TextBlock x:Name="SpotlightSeriesPreviewText" Foreground="{ThemeResource AppMutedTextBrush}"
                                           FontSize="16" TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Name="SpotlightSaveButton" Content="Save" MinWidth="100" MinHeight="48"
                                            FontSize="16" Style="{StaticResource AppQuietButtonStyle}"
                                            AutomationProperties.Name="Save Spotlight settings"
                                            Click="SpotlightSaveButton_Click" />
                                    <Button x:Name="SpotlightCancelButton" Content="Cancel" MinWidth="100" MinHeight="48"
                                            FontSize="16" Style="{StaticResource AppQuietButtonStyle}"
                                            AutomationProperties.Name="Cancel Spotlight settings changes"
                                            Click="SpotlightCancelButton_Click" />
                                    <TextBlock x:Name="SpotlightSettingsStatusText" FontSize="16"
                                               VerticalAlignment="Center" Foreground="{ThemeResource AppMutedTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="PlayerTabPanel" Visibility="Collapsed">
                <Border Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="16" Padding="24">
                    <StackPanel Spacing="10">
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Playback engine" />
                        <ComboBox x:Name="PlaybackEngineSelector"
                                  MinWidth="220"
                                  FontSize="16"
                                  SelectionChanged="PlaybackEngineSelector_SelectionChanged"
                                  AutomationProperties.Name="Playback engine">
                            <ComboBoxItem Content="Native player" Tag="Native" />
                            <ComboBoxItem Content="LibVLC" Tag="LibVLC" />
                        </ComboBox>
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Playback attempts" />
                        <ComboBox x:Name="PlaybackAttemptsSelector" MinWidth="220" FontSize="16"
                                  SelectionChanged="PlaybackAttemptsSelector_SelectionChanged"
                                  AutomationProperties.Name="Playback attempts">
                            <ComboBoxItem Content="1" Tag="1" />
                            <ComboBoxItem Content="2" Tag="2" />
                            <ComboBoxItem Content="3" Tag="3" />
                            <ComboBoxItem Content="4" Tag="4" />
                            <ComboBoxItem Content="5" Tag="5" />
                            <ComboBoxItem Content="6" Tag="6" />
                            <ComboBoxItem Content="7" Tag="7" />
                            <ComboBoxItem Content="8" Tag="8" />
                            <ComboBoxItem Content="9" Tag="9" />
                            <ComboBoxItem Content="10" Tag="10" />
                        </ComboBox>
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" TextWrapping="Wrap"
                                   Text="How many times Tvivo tries before giving up (default 5)." />
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15"
                                   Text="When minimizing while a video is open" />
                        <ComboBox x:Name="MinimizeToMiniSelector" MinWidth="300" FontSize="16"
                                  SelectionChanged="MinimizeToMiniSelector_SelectionChanged"
                                  AutomationProperties.Name="When minimizing while a video is open">
                            <ComboBoxItem Content="Mini player while playing" Tag="MiniPlayerWhilePlaying" />
                            <ComboBoxItem Content="Mini player while playing or paused" Tag="MiniPlayerWhilePlayingOrPaused" />
                            <ComboBoxItem Content="Always minimize normally" Tag="AlwaysMinimizeNormally" />
                        </ComboBox>
                        <TextBlock x:Name="MinimizeToMiniDescription" Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" TextWrapping="Wrap"
                                   Text="When LibVLC is playing or paused, minimizing keeps the video in a small always-on-top window." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="LibraryTabPanel" Visibility="Collapsed">
                <Border Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="16" Padding="24">
                    <StackPanel Spacing="10">
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Most recent catalog refresh" />
                        <TextBlock x:Name="LastRefreshText" Foreground="{ThemeResource AppTextBrush}" FontSize="18" />
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" Text="Refresh catalog" />
                        <ComboBox x:Name="CatalogRefreshPolicySelector" MinWidth="300" FontSize="16"
                                  SelectionChanged="CatalogRefreshPolicySelector_SelectionChanged"
                                  AutomationProperties.Name="Refresh catalog">
                            <ComboBoxItem Content="Only when I refresh" Tag="OnDemandOnly" />
                            <ComboBoxItem Content="If older than 1 day" Tag="OlderThanOneDay" />
                            <ComboBoxItem Content="If older than 7 days" Tag="OlderThanSevenDays" />
                            <ComboBoxItem Content="Every time the app opens" Tag="EveryStart" />
                        </ComboBox>
                        <Button x:Name="RefreshCatalogButton" Style="{StaticResource AppQuietButtonStyle}"
                                FontSize="16" HorizontalAlignment="Left" Content="Refresh all"
                                Click="RefreshCatalogButton_Click" />
                        <Button x:Name="ClearArtworkCacheButton" Style="{StaticResource AppQuietButtonStyle}"
                                FontSize="16" HorizontalAlignment="Left" Content="Clear artwork cache"
                                Click="ClearArtworkCacheButton_Click" />
                        <TextBlock x:Name="ArtworkCacheStatusText" Foreground="{ThemeResource AppMutedTextBrush}"
                                   FontSize="15" Visibility="Collapsed" />
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="15" TextWrapping="Wrap"
                                   Text="Re-downloads your provider's catalog. Favorites, resume positions and visit history are kept. Large catalogs can take a few minutes." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{ThemeResource AppDangerTextBrush}" FontSize="18" TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
