<UserControl x:Class="Tvivo.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="52,36" Background="{ThemeResource AppCanvasBrush}">
        <StackPanel x:Name="SetupPanel" MaxWidth="760" Spacing="20" VerticalAlignment="Center">
            <TextBlock Foreground="{ThemeResource AppAccentBrush}" FontSize="13" FontWeight="Bold"
                       CharacterSpacing="180" Text="YOUR ENTERTAINMENT, CONNECTED" />
            <TextBlock Foreground="{ThemeResource AppTextBrush}" FontSize="46" FontWeight="SemiBold"
                       Text="Welcome to Tvivo" />
            <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="18" TextWrapping="Wrap"
                       Text="Your home for live channels, films, and series. Connect a provider to start building your library." />
            <Border Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="12" Padding="22" Margin="0,14,0,0">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock Foreground="{ThemeResource AppTextBrush}" FontSize="17" FontWeight="SemiBold"
                                   Text="Continue setup" />
                        <TextBlock Foreground="{ThemeResource AppMutedTextBrush}" FontSize="14"
                                   Text="Provider sign-in is the next step for your library." />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource AppPrimaryButtonStyle}"
                            VerticalAlignment="Center" Content="Set up provider" Click="SetupProvider_Click" />
                </Grid>
            </Border>
        </StackPanel>
        <ScrollViewer x:Name="ShelvesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="28">
                <StackPanel Spacing="5">
                    <TextBlock Text="Welcome back" Foreground="{ThemeResource AppTextBrush}"
                               FontSize="38" FontWeight="SemiBold" />
                    <TextBlock Text="Pick up where you left off, or find something new."
                               Foreground="{ThemeResource AppMutedTextBrush}" FontSize="17" />
                </StackPanel>
                <StackPanel x:Name="ContinueSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Continue Watching" Foreground="{ThemeResource AppTextBrush}"
                               FontSize="24" FontWeight="SemiBold" />
                    <GridView x:Name="ContinueGrid" IsItemClickEnabled="True" SelectionMode="None"
                              ItemClick="Shelf_ItemClick" HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="172" Spacing="7" Margin="0,0,10,0">
                                    <Border Width="160" Height="225" Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="8">
                                        <Grid>
                                            <Image Stretch="UniformToFill" Loaded="Artwork_Loaded"
                                                   Unloaded="Artwork_Unloaded" DataContextChanged="Artwork_DataContextChanged" />
                                            <Border Height="4" VerticalAlignment="Bottom" CornerRadius="2"
                                                    Background="{ThemeResource AppPanelSurfaceBrush}"
                                                    Visibility="{Binding ProgressTrackVisibility}"
                                                    AutomationProperties.Name="{Binding ProgressAutomationName}">
                                                <Border HorizontalAlignment="Left" Width="{Binding ProgressWidth}"
                                                        CornerRadius="2" Background="{ThemeResource AppAccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Foreground="{ThemeResource AppTextBrush}"
                                               FontSize="15" MaxLines="2" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource AppMutedTextBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding TimeLeft}" Foreground="{ThemeResource AppMutedTextBrush}"
                                               FontSize="12" Visibility="{Binding ProgressTrackVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
                <StackPanel Spacing="12">
                    <TextBlock Text="Suggestions" Foreground="{ThemeResource AppTextBrush}"
                               FontSize="24" FontWeight="SemiBold" />
                    <GridView x:Name="SuggestionsGrid" IsItemClickEnabled="True" SelectionMode="None"
                              ItemClick="Shelf_ItemClick" HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="172" Spacing="7" Margin="0,0,10,0">
                                    <Border Width="160" Height="225" Background="{ThemeResource AppPanelSurfaceBrush}" CornerRadius="8">
                                        <Grid>
                                            <Image Stretch="UniformToFill" Loaded="Artwork_Loaded"
                                                   Unloaded="Artwork_Unloaded" DataContextChanged="Artwork_DataContextChanged" />
                                            <Border Height="4" VerticalAlignment="Bottom" CornerRadius="2"
                                                    Background="{ThemeResource AppPanelSurfaceBrush}"
                                                    Visibility="{Binding ProgressTrackVisibility}"
                                                    AutomationProperties.Name="{Binding ProgressAutomationName}">
                                                <Border HorizontalAlignment="Left" Width="{Binding ProgressWidth}"
                                                        CornerRadius="2" Background="{ThemeResource AppAccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Foreground="{ThemeResource AppTextBrush}"
                                               FontSize="15" MaxLines="2" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{ThemeResource AppMutedTextBrush}"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding TimeLeft}" Foreground="{ThemeResource AppMutedTextBrush}"
                                               FontSize="12" Visibility="{Binding ProgressTrackVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
