<UserControl
    x:Class="Tvivo.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="52,44" Background="{StaticResource AppCanvasBrush}">
        <StackPanel MaxWidth="760" Spacing="20" VerticalAlignment="Center">
            <TextBlock Foreground="{StaticResource AppAccentBrush}"
                       FontSize="13"
                       FontWeight="Bold"
                       CharacterSpacing="180"
                       Text="YOUR ENTERTAINMENT, CONNECTED" />
            <TextBlock Foreground="{StaticResource AppTextBrush}"
                       FontSize="46"
                       FontWeight="SemiBold"
                       Text="Welcome to Tvivo" />
            <TextBlock Foreground="{StaticResource AppMutedTextBrush}"
                       FontSize="18"
                       TextWrapping="Wrap"
                       Text="Your home for live channels, films, and series. Connect a provider to start building your library." />
            <Border Background="{StaticResource AppPanelSurfaceBrush}"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,14,0,0">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource AppTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Continue setup" />
                        <TextBlock Foreground="{StaticResource AppMutedTextBrush}"
                                   FontSize="14"
                                   Text="Provider sign-in is the next step for your library." />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource AppPrimaryButtonStyle}"
                            VerticalAlignment="Center"
                            Content="Set up provider"
                            Click="SetupProvider_Click" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
