<UserControl
    x:Class="Tvivo.App.Pages.CatalogLandingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tvivo.App.Pages"
    MinWidth="776">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="HorizontalShelfPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CatalogGridPanel">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="HorizontalSkeletonPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ShelfSkeletonTemplate">
            <Grid Width="{Binding Width}" Height="{Binding Height}"
                  Margin="0,12,14,0" IsHitTestVisible="False"
                  AutomationProperties.AccessibilityView="Raw">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="12">
                    <Grid>
                        <Rectangle RadiusX="12" RadiusY="12">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{ThemeResource AppPlaceholderStartColor}" Offset="0" />
                                    <GradientStop Color="{ThemeResource AppPlaceholderMidColor}" Offset="0.58" />
                                    <GradientStop Color="{ThemeResource AppPlaceholderEndColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Viewbox Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Opacity="0.32">
                            <Grid Width="64" Height="64">
                                <Border Margin="5" CornerRadius="11" BorderThickness="3" BorderBrush="{ThemeResource AppPlaceholderFrameBrush}" />
                                <Border Margin="3,10,3,10" CornerRadius="7" BorderThickness="3" BorderBrush="{ThemeResource AppPlaceholderFrameInnerBrush}" />
                                <Path Data="M13,32 L23,32 L28,25 L35,40 L41,31 L51,31"
                                      Stroke="{ThemeResource AppPlaceholderWaveBrush}" StrokeThickness="3.5" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Width="{Binding TitleWidth}" Height="7" CornerRadius="4"
                        HorizontalAlignment="Left" Margin="0,9,0,0"
                        Background="{ThemeResource AppRaisedSurfaceBrush}" />
                <Border Grid.Row="2" Width="{Binding SubtitleWidth}" Height="6" CornerRadius="3"
                        HorizontalAlignment="Left" Margin="0,6,0,0"
                        Background="{ThemeResource AppRaisedSurfaceBrush}" Opacity="0.92" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="TvivoArtworkPlaceholderTemplate">
            <Grid x:Name="PlaceholderArtworkRoot">
                <Rectangle RadiusX="12" RadiusY="12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{ThemeResource AppPlaceholderStartColor}" Offset="0" />
                            <GradientStop Color="{ThemeResource AppPlaceholderMidColor}" Offset="0.58" />
                            <GradientStop Color="{ThemeResource AppPlaceholderEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Viewbox x:Name="PlaceholderArtworkGlyph" Width="108" Height="108"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <ScaleTransform x:Name="PlaceholderArtworkScale" ScaleX="1" ScaleY="1" />
                    </Viewbox.RenderTransform>
                    <Grid Width="64" Height="64">
                        <Border Margin="5" CornerRadius="11" BorderThickness="3" BorderBrush="{ThemeResource AppPlaceholderFrameBrush}" />
                        <Border Margin="3,10,3,10" CornerRadius="7" BorderThickness="3" BorderBrush="{ThemeResource AppPlaceholderFrameInnerBrush}" />
                        <Path Data="M13,32 L23,32 L28,25 L35,40 L41,31 L51,31"
                              Stroke="{ThemeResource AppPlaceholderWaveBrush}" StrokeThickness="3.5" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Grid>
                </Viewbox>
                <TextBlock Text="TVIVO" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                           Foreground="{ThemeResource AppPlaceholderWordmarkBrush}" FontSize="16" FontWeight="Bold" CharacterSpacing="180" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CatalogCardTemplate">
            <Grid Width="{Binding Width}" Height="{Binding Height}"
                  PointerEntered="CatalogCard_PointerEntered"
                  PointerExited="CatalogCard_PointerExited"
                  GotFocus="CatalogCard_GotFocus"
                  LostFocus="CatalogCard_LostFocus"
                  DataContextChanged="CatalogCard_DataContextChanged"
                  Unloaded="CatalogCard_Unloaded">
                <Border CornerRadius="12" Background="{ThemeResource AppRaisedSurfaceBrush}">
                    <Grid>
                        <Grid x:Name="ArtworkViewport">
                            <ContentControl x:Name="ArtworkFallback" Content="Tvivo"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            ContentTemplate="{StaticResource TvivoArtworkPlaceholderTemplate}" />
                            <Image Stretch="UniformToFill" Opacity="0" RenderTransformOrigin="0.5,0.5"
                                   Loaded="ArtworkImage_Loaded"
                                   Unloaded="ArtworkImage_Unloaded">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="ArtworkImageScale" ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                        <Border VerticalAlignment="Bottom" Padding="10,36,10,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00071114" Offset="0" />
                                    <GradientStop Color="#F0071114" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{ThemeResource AppOnMediaTextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="{ThemeResource AppOnMediaMutedBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DetailsLine}"
                                           Foreground="{ThemeResource AppOnMediaMutedBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TimeLeft}"
                                           Visibility="{Binding ContinueProgressVisibility}"
                                           Foreground="{ThemeResource AppOnMediaMutedBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Visibility="{Binding EpgVisibility}"
                                            Spacing="1"
                                            AutomationProperties.Name="{Binding EpgAutomationName}">
                                    <TextBlock Text="{Binding NowText}"
                                               Visibility="{Binding NowVisibility}"
                                               Foreground="{ThemeResource AppOnMediaTextBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{Binding ProgressValue}"
                                                 Maximum="100"
                                                 Height="2"
                                                 Padding="0"
                                                 IsHitTestVisible="False"
                                                 Visibility="{Binding ProgressVisibility}"
                                                 Foreground="{ThemeResource AppAccentBrush}"
                                                 Background="{ThemeResource AppLineBrush}" />
                                    <TextBlock Text="{Binding NextText}"
                                               Visibility="{Binding NextVisibility}"
                                               Foreground="{ThemeResource AppOnMediaMutedBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ProgressBar Value="{Binding WatchProgressValue}"
                                     Maximum="100"
                                     Height="3"
                                     MinHeight="3"
                                     Padding="0"
                                     VerticalAlignment="Bottom"
                                     Margin="10,0,10,5"
                                     IsHitTestVisible="False"
                                     Visibility="{Binding WatchProgressVisibility}"
                                     Foreground="{ThemeResource AppAccentBrush}"
                                     Background="{ThemeResource AppLineBrush}"
                                     AutomationProperties.Name="{Binding WatchProgressAutomationName}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,8,8,0"
                                Padding="7,3" CornerRadius="8"
                                Background="{ThemeResource AppAccentBrush}"
                                Visibility="{Binding QualityBadgeVisibility}">
                            <TextBlock Text="{Binding QualityBadge}"
                                       Foreground="{ThemeResource AppCanvasBrush}"
                                       FontSize="10" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="CatalogPageRoot" Padding="48,24,48,20" Background="{ThemeResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="CatalogHeader" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="ModeButtons"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                <StackPanel x:Name="ModeButtonStackPanel" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="MyTvivoButton"
                            Content="For You"
                            Style="{StaticResource AppQuietButtonStyle}"
                            Click="ModeButton_Click"
                            Tag="MyTvivo" />
                    <Button x:Name="MoviesButton"
                            Content="Movies"
                            Style="{StaticResource AppQuietButtonStyle}"
                            Click="ModeButton_Click"
                            Tag="Movies" />
                    <Button x:Name="SeriesButton"
                            Content="Series"
                            Style="{StaticResource AppQuietButtonStyle}"
                            Click="ModeButton_Click"
                            Tag="Series" />
                </StackPanel>
            </ContentControl>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PageSearchPanel"
                    BorderBrush="{ThemeResource AppLineBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource AppPanelSurfaceBrush}"
                    CornerRadius="22"
                    Padding="12,8"
                    MaxWidth="420"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             MinWidth="260"
                             PlaceholderText="Search this catalog"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{ThemeResource AppTextBrush}"
                             TextChanged="SearchBox_TextChanged" />
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Content="Clear"
                            Visibility="Collapsed"
                            Click="ClearSearch_Click" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel x:Name="LoadingState"
                        Visibility="Visible"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              Width="48"
                              Height="48"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource AppAccentBrush}" />
                <TextBlock Foreground="{ThemeResource AppMutedTextBrush}"
                           FontSize="17"
                           Text="Loading your catalog..." />
            </StackPanel>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock x:Name="EmptyTitle"
                           Foreground="{ThemeResource AppTextBrush}"
                           FontSize="22"
                           Text="No catalog items found" />
                <TextBlock x:Name="EmptyMessage"
                           Foreground="{ThemeResource AppMutedTextBrush}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           Text="This provider returned no browsable catalog data yet. Check the account or try again later." />
            </StackPanel>

            <StackPanel x:Name="ErrorState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Foreground="{ThemeResource AppTextBrush}" FontSize="22" Text="Catalog could not be loaded" />
                <TextBlock x:Name="ErrorMessage"
                           Foreground="{ThemeResource AppAccentSoftBrush}"
                           FontSize="16"
                           TextWrapping="Wrap" />
                <Button Content="Retry"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Click="Retry_Click"
                        HorizontalAlignment="Left" />
            </StackPanel>

            <Grid x:Name="ContentState"
                  Visibility="Collapsed"
                  RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                    <StackPanel x:Name="SearchResultsPanel" Grid.Row="0" Visibility="Collapsed" Spacing="12">
                        <Grid>
                            <TextBlock x:Name="SearchResultsCount" Foreground="{ThemeResource AppTextBrush}"
                                       FontSize="22" FontWeight="SemiBold" />
                        </Grid>
                        <!-- Folder chips wrap onto rows (two by default); "+N more" opens the rest. No sideways scrolling. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          HorizontalScrollMode="Disabled">
                                <local:WrapPanel x:Name="SearchCategoryChips" MaxRows="2" />
                            </ScrollViewer>
                            <Button x:Name="SearchChipsToggle" Grid.Column="1" VerticalAlignment="Top"
                                    Visibility="Collapsed" Padding="12,7" MinHeight="0"
                                    Style="{StaticResource AppQuietButtonStyle}"
                                    Click="SearchChipsToggle_Click" />
                        </Grid>
                    </StackPanel>
                    <Grid x:Name="OpenShelfHeader" Grid.Row="0" Visibility="Collapsed" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="All categories"
                                Style="{StaticResource AppQuietButtonStyle}"
                                Click="BackToShelves_Click" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="OpenShelfTitle"
                                       Foreground="{ThemeResource AppTextBrush}"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="OpenShelfCount"
                                   Grid.Column="2"
                                   Foreground="{ThemeResource AppMutedTextBrush}"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                    <ListView x:Name="ShelvesItems"
                              Grid.Row="1"
                              Margin="0,-18,0,0"
                              Loaded="ShelvesItems_Loaded"
                              Unloaded="ShelvesItems_Unloaded"
                              ShowsScrollingPlaceholders="False"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Grid x:Name="RootGrid" Background="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="BackgroundElement.Background" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="BackgroundElement.Background" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled" />
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="SelectionStates">
                                                        <VisualState x:Name="Unselected" />
                                                        <VisualState x:Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Target="BackgroundElement.Background" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="BackgroundElement.Background" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="SelectedPressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="BackgroundElement.Background" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Border x:Name="BackgroundElement" Background="{TemplateBinding Background}" />
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                        <StackPanel>
                            <Border x:Name="SpotlightPanel"
                                    Margin="0,0,0,30"
                                    Padding="20,12"
                                    CornerRadius="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{ThemeResource AppSurfaceRaisedColor}" Offset="0" />
                                        <GradientStop Color="{ThemeResource AppSurfaceColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8" VerticalAlignment="Center">
                                        <Border x:Name="SpotlightArtworkTarget" Width="176" Height="99" CornerRadius="12"
                                                Tapped="SpotlightArtwork_Tapped"
                                                AutomationProperties.Name="Open spotlight item">
                                            <Grid>
                                                <ContentControl x:Name="SpotlightArtworkFallback" Content="Tvivo"
                                                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                                ContentTemplate="{StaticResource TvivoArtworkPlaceholderTemplate}" />
                                                <Image x:Name="SpotlightArtwork" Stretch="UniformToFill" Opacity="0"
                                                       Loaded="ArtworkImage_Loaded" Unloaded="ArtworkImage_Unloaded" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="SpotlightEyebrow"
                                                   Style="{StaticResource AppEyebrowTextStyle}"
                                                   Text="TVIVO SPOTLIGHT" />
                                        <TextBlock x:Name="SpotlightTitle"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="WrapWholeWords" />
                                        <TextBlock x:Name="SpotlightSubtitle"
                                                   Foreground="{ThemeResource AppMutedTextBrush}"
                                                   FontSize="15" />
                                    </StackPanel>
                                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom" Spacing="3">
                                            <Button x:Name="SpotlightPreviousButton" Content="‹"
                                                    Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0"
                                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                                    FontSize="20" Style="{StaticResource AppCaptionButtonStyle}"
                                                    Click="SpotlightPrevious_Click"
                                                    AutomationProperties.Name="Previous spotlight item"
                                                    ToolTipService.ToolTip="{x:Null}" />
                                            <StackPanel x:Name="SpotlightIndicatorRow" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Spacing="2" />
                                            <Button x:Name="SpotlightNextButton" Content="›"
                                                    Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0"
                                                    Foreground="{ThemeResource AppMutedTextBrush}"
                                                    FontSize="20" Style="{StaticResource AppCaptionButtonStyle}"
                                                    Click="SpotlightNext_Click"
                                                    AutomationProperties.Name="Next spotlight item"
                                                    ToolTipService.ToolTip="{x:Null}" />
                                        </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16"
                                                    Loaded="ShelfContainer_Loaded"
                                                    Unloaded="ShelfContainer_Unloaded">
                                            <Grid Margin="0,0,0,16" ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource AppShelfTitleButtonStyle}"
                                                        Click="ShelfTitle_Click"
                                                        Tag="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Title}" />
                                                        <Border Padding="6,2" CornerRadius="7"
                                                                Background="{ThemeResource AppAccentBrush}"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding NewSinceLastVisitVisibility}"
                                                                AutomationProperties.Name="New since last visit">
                                                            <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{ThemeResource AppCanvasBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Content="{Binding CountLabel}"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource AppShelfTitleButtonStyle}"
                                                        FontSize="12"
                                                        FontWeight="Normal"
                                                        Foreground="{ThemeResource AppMutedTextBrush}"
                                                        VerticalAlignment="Center"
                                                        Click="ShelfCount_Click"
                                                        AutomationProperties.Name="Open full category listing" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding SkeletonTiles}"
                                                          ItemTemplate="{StaticResource ShelfSkeletonTemplate}"
                                                          ItemsPanel="{StaticResource HorizontalSkeletonPanel}"
                                                          Visibility="{Binding SkeletonVisibility}"
                                                          Height="{Binding SkeletonRowHeight}"
                                                          IsHitTestVisible="False" />
                                            <GridView x:Name="ShelfPreviewGrid"
                                                      ItemsSource="{Binding Cards}"
                                                      ItemTemplate="{StaticResource CatalogCardTemplate}"
                                                      ItemsPanel="{StaticResource HorizontalShelfPanel}"
                                                      Style="{StaticResource AppShelfGridViewStyle}"
                                                      ShowsScrollingPlaceholders="False"
                                                      Visibility="{Binding PreviewVisibility}"
                                                      ItemClick="ShelfCards_ItemClick"
                                                      KeyDown="ShelfGrid_KeyDown"
                                                      Loaded="ShelfGrid_Loaded"
                                                      Unloaded="ShelfGrid_Unloaded"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                                      ScrollViewer.VerticalScrollMode="Disabled">
                                                <GridView.ItemContainerTransitions>
                                                    <TransitionCollection />
                                                </GridView.ItemContainerTransitions>
                                            </GridView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                    </ListView>

                    <GridView x:Name="OpenShelfGrid"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              ShowsScrollingPlaceholders="False"
                              ItemTemplate="{StaticResource CatalogCardTemplate}"
                              ItemsPanel="{StaticResource CatalogGridPanel}"
                              Style="{StaticResource AppShelfGridViewStyle}"
                              ItemClick="ShelfCards_ItemClick"
                              KeyDown="OpenShelfGrid_KeyDown"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                    </GridView>

                    <!-- Scroll helper: jump to top / page up / page down / bottom, sitting in the page's right padding. -->
                    <StackPanel x:Name="ScrollNavPanel"
                                Grid.Row="1"
                                Spacing="2"
                                Width="40"
                                Padding="2,6"
                                CornerRadius="20"
                                Background="{ThemeResource AppScrollPillBrush}"
                                BorderBrush="{ThemeResource AppScrollPillBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,-44,0">
                        <Button Content="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="36" Height="36" Padding="0"
                                Style="{StaticResource AppIconButtonStyle}" Click="ScrollTop_Click"
                                ToolTipService.ToolTip="Jump to top" AutomationProperties.Name="Jump to top" />
                        <Button Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="36" Height="36" Padding="0"
                                Style="{StaticResource AppIconButtonStyle}" Click="ScrollPageUp_Click"
                                ToolTipService.ToolTip="Page up" AutomationProperties.Name="Page up" />
                        <Button Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="36" Height="36" Padding="0"
                                Style="{StaticResource AppIconButtonStyle}" Click="ScrollPageDown_Click"
                                ToolTipService.ToolTip="Page down" AutomationProperties.Name="Page down" />
                        <Button Content="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="36" Height="36" Padding="0"
                                Style="{StaticResource AppIconButtonStyle}" Click="ScrollBottom_Click"
                                ToolTipService.ToolTip="Jump to bottom" AutomationProperties.Name="Jump to bottom" />
                    </StackPanel>

                    <StackPanel x:Name="PagerPanel"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button x:Name="PreviousPageButton"
                                Content="Previous"
                                MinWidth="96"
                                Style="{StaticResource AppQuietButtonStyle}"
                                Click="PreviousPage_Click"
                                IsEnabled="False" />
                        <TextBlock x:Name="PageStatus"
                                   MinWidth="216"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource AppMutedTextBrush}" />
                        <Button x:Name="NextPageButton"
                                Content="Next"
                                MinWidth="96"
                                Style="{StaticResource AppQuietButtonStyle}"
                                Click="NextPage_Click"
                                IsEnabled="False" />
                    </StackPanel>
            </Grid>
        </Grid>

        <InfoBar x:Name="RefreshInfoBar"
                 Grid.Row="0"
                 Grid.RowSpan="3"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Center"
                 MaxWidth="640"
                 Margin="0,0,0,8"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Informational"
                 Message="Refreshing...">
            <InfoBar.ActionButton>
                <Button x:Name="RefreshRetryButton"
                        Content="Retry"
                        Visibility="Collapsed"
                        Click="Retry_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid x:Name="FirstLoadTakeover"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Opacity="1"
              Background="{ThemeResource AppCanvasBrush}"
              IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
                <TextBlock Text="TVIVO"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource AppTextBrush}"
                           FontSize="42"
                           FontWeight="Bold"
                           CharacterSpacing="80" />
                <ProgressRing IsActive="True"
                              Width="36"
                              Height="36"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource AppAccentBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
