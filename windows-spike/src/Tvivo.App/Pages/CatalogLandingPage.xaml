<UserControl
    x:Class="Tvivo.App.Pages.CatalogLandingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="776"
    RequestedTheme="Dark">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="HorizontalShelfPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CatalogGridPanel">
            <ItemsWrapGrid Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="TvivoArtworkPlaceholderTemplate">
            <Grid>
                <Rectangle RadiusX="12" RadiusY="12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#12383F" Offset="0" />
                            <GradientStop Color="#1B5557" Offset="0.58" />
                            <GradientStop Color="#A66B43" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Viewbox Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="64" Height="64">
                        <Border Margin="5" CornerRadius="11" BorderThickness="3" BorderBrush="#DDF4EDE5" />
                        <Border Margin="3,10,3,10" CornerRadius="7" BorderThickness="3" BorderBrush="#EAF4EDE5" />
                        <Path Data="M13,32 L23,32 L28,25 L35,40 L41,31 L51,31"
                              Stroke="#F0BE86" StrokeThickness="3.5" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                    </Grid>
                </Viewbox>
                <TextBlock Text="TVIVO" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                           Foreground="#CFE8E2D8" FontSize="16" FontWeight="Bold" CharacterSpacing="180" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CatalogCardTemplate">
            <Grid Width="{Binding Width}" Height="{Binding Height}">
                <Border CornerRadius="12" Background="{StaticResource AppRaisedSurfaceBrush}">
                    <Grid>
                        <Grid>
                            <ContentControl x:Name="ArtworkFallback" Content="Tvivo"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            ContentTemplate="{StaticResource TvivoArtworkPlaceholderTemplate}" />
                            <Image Stretch="UniformToFill" Opacity="0"
                                   Loaded="ArtworkImage_Loaded"
                                   Unloaded="ArtworkImage_Unloaded"
                                   DataContextChanged="ArtworkImage_DataContextChanged"
                                   ImageOpened="ArtworkImage_Opened"
                                   ImageFailed="ArtworkImage_Failed" />
                        </Grid>
                        <Border VerticalAlignment="Bottom" Padding="10,36,10,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00071114" Offset="0" />
                                    <GradientStop Color="#F0071114" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{StaticResource AppTextBrush}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="{StaticResource AppMutedTextBrush}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DetailsLine}"
                                           Foreground="{StaticResource AppMutedTextBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="CatalogPageRoot" Padding="48,38,48,64" Background="{StaticResource AppCanvasBrush}" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="CatalogHeader" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Name="PageEyebrow"
                           Style="{StaticResource AppEyebrowTextStyle}"
                           Text="YOUR LIBRARY" />
                <TextBlock x:Name="PageTitle"
                           Foreground="{StaticResource AppTextBrush}"
                           FontSize="36"
                           FontWeight="SemiBold"
                           Text="My Tvivo" />
            </StackPanel>
            <ContentControl x:Name="ModeButtons"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                <StackPanel x:Name="ModeButtonStackPanel" Orientation="Horizontal" Spacing="12">
                    <Button x:Name="MyTvivoButton"
                            Content="My Tvivo"
                            Style="{StaticResource AppQuietButtonStyle}"
                            Click="ModeButton_Click"
                            Tag="MyTvivo" />
                    <Button x:Name="MoviesButton"
                            Content="Movies"
                            Style="{StaticResource AppQuietButtonStyle}"
                            Click="ModeButton_Click"
                            Tag="Movies" />
                    <Button x:Name="SeriesButton"
                            Content="Series"
                            Style="{StaticResource AppQuietButtonStyle}"
                            Click="ModeButton_Click"
                            Tag="Series" />
                </StackPanel>
            </ContentControl>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="18" MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="PageSearchPanel"
                    BorderBrush="{StaticResource AppLineBrush}"
                    BorderThickness="1"
                    Background="{StaticResource AppPanelSurfaceBrush}"
                    CornerRadius="22"
                    Padding="12,8"
                    MaxWidth="420"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             MinWidth="260"
                             PlaceholderText="Search this catalog"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource AppTextBrush}"
                             TextChanged="SearchBox_TextChanged" />
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Content="Clear"
                            Visibility="Collapsed"
                            Click="ClearSearch_Click" />
                </Grid>
            </Border>
            <StackPanel x:Name="SortPanel" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Foreground="{StaticResource AppMutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="Sort categories" />
                <ComboBox x:Name="CategorySortBox"
                          MinWidth="180"
                          SelectionChanged="CategorySortBox_SelectionChanged">
                    <ComboBoxItem Content="Most visited" Tag="Visited" IsSelected="True" />
                    <ComboBoxItem Content="Alphabetical (A-Z)" Tag="AlphabeticalAsc" />
                    <ComboBoxItem Content="Alphabetical (Z-A)" Tag="AlphabeticalDesc" />
                    <ComboBoxItem Content="Recently added" Tag="RecentlyAdded" />
                    <ComboBoxItem Content="Recently updated" Tag="RecentlyUpdated" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel x:Name="LoadingState"
                        Visibility="Visible"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16">
                <ProgressRing IsActive="True"
                              Width="48"
                              Height="48"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource AppAccentBrush}" />
                <TextBlock Foreground="{StaticResource AppMutedTextBrush}"
                           FontSize="17"
                           Text="Loading your catalog..." />
            </StackPanel>

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock x:Name="EmptyTitle"
                           Foreground="{StaticResource AppTextBrush}"
                           FontSize="22"
                           Text="No catalog items found" />
                <TextBlock x:Name="EmptyMessage"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           Text="This provider returned no browsable catalog data yet. Check the account or try again later." />
            </StackPanel>

            <StackPanel x:Name="ErrorState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Foreground="{StaticResource AppTextBrush}" FontSize="22" Text="Catalog could not be loaded" />
                <TextBlock x:Name="ErrorMessage"
                           Foreground="{StaticResource AppAccentSoftBrush}"
                           FontSize="16"
                           TextWrapping="Wrap" />
                <Button Content="Retry"
                        Style="{StaticResource AppPrimaryButtonStyle}"
                        Click="Retry_Click"
                        HorizontalAlignment="Left" />
            </StackPanel>

            <Grid x:Name="ContentState"
                  Visibility="Collapsed"
                  RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                    <Grid x:Name="OpenShelfHeader" Grid.Row="0" Visibility="Collapsed" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="All categories"
                                Style="{StaticResource AppQuietButtonStyle}"
                                Click="BackToShelves_Click" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Style="{StaticResource AppEyebrowTextStyle}" Text="CATEGORY" />
                            <TextBlock x:Name="OpenShelfTitle"
                                       Foreground="{StaticResource AppTextBrush}"
                                       FontSize="28"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="OpenShelfCount"
                                   Grid.Column="2"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                    <ListView x:Name="ShelvesItems"
                              Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.Header>
                        <StackPanel Spacing="26">
                            <InfoBar x:Name="RefreshInfoBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Message="Refreshing...">
                                <InfoBar.ActionButton>
                                    <Button x:Name="RefreshRetryButton"
                                            Content="Retry"
                                            Visibility="Collapsed"
                                            Click="Retry_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <Border x:Name="SpotlightPanel"
                                    Padding="30,22"
                                    CornerRadius="18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{StaticResource AppSurfaceRaisedColor}" Offset="0" />
                                        <GradientStop Color="{StaticResource AppSurfaceColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid ColumnSpacing="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="300" Height="168" CornerRadius="14"
                                            Tapped="SpotlightArtwork_Tapped"
                                            AutomationProperties.Name="Open spotlight item">
                                        <Grid>
                                            <ContentControl x:Name="SpotlightArtworkFallback" Content="Tvivo"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                            ContentTemplate="{StaticResource TvivoArtworkPlaceholderTemplate}" />
                                            <Image x:Name="SpotlightArtwork" Stretch="UniformToFill" Opacity="0"
                                                   Loaded="ArtworkImage_Loaded" Unloaded="ArtworkImage_Unloaded"
                                                   ImageOpened="ArtworkImage_Opened" ImageFailed="ArtworkImage_Failed" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="SpotlightEyebrow"
                                                   Style="{StaticResource AppEyebrowTextStyle}"
                                                   Text="TVIVO SPOTLIGHT" />
                                        <TextBlock x:Name="SpotlightTitle"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="WrapWholeWords" />
                                        <TextBlock x:Name="SpotlightSubtitle"
                                                   Foreground="{StaticResource AppMutedTextBrush}"
                                                   FontSize="15" />
                                        <Button x:Name="SpotlightAction"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Content="Open category"
                                                Style="{StaticResource AppPrimaryButtonStyle}"
                                                Click="SpotlightAction_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,30"
                                                    Loaded="ShelfContainer_Loaded"
                                                    Unloaded="ShelfContainer_Unloaded">
                                            <Grid Margin="0,0,0,16" ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="{Binding Title}"
                                                        Style="{StaticResource AppShelfTitleButtonStyle}"
                                                        Click="ShelfTitle_Click"
                                                        Tag="{Binding}" />
                                                <Button Grid.Column="1"
                                                        Content="{Binding CountLabel}"
                                                        Tag="{Binding}"
                                                        Style="{StaticResource AppShelfTitleButtonStyle}"
                                                        FontSize="12"
                                                        FontWeight="Normal"
                                                        Foreground="{StaticResource AppMutedTextBrush}"
                                                        VerticalAlignment="Center"
                                                        Click="ShelfCount_Click"
                                                        AutomationProperties.Name="Open full category listing" />
                                            </Grid>
                                            <GridView ItemsSource="{Binding Cards}"
                                                      ItemTemplate="{StaticResource CatalogCardTemplate}"
                                                      ItemsPanel="{StaticResource HorizontalShelfPanel}"
                                                      Style="{StaticResource AppShelfGridViewStyle}"
                                                      ItemClick="ShelfCards_ItemClick"
                                                      KeyDown="ShelfGrid_KeyDown"
                                                      Loaded="ShelfGrid_Loaded"
                                                      Unloaded="ShelfGrid_Unloaded"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                                      ScrollViewer.VerticalScrollMode="Disabled" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                    </ListView>

                    <GridView x:Name="OpenShelfGrid"
                              Grid.Row="1"
                              Visibility="Collapsed"
                              ItemTemplate="{StaticResource CatalogCardTemplate}"
                              ItemsPanel="{StaticResource CatalogGridPanel}"
                              Style="{StaticResource AppShelfGridViewStyle}"
                              ItemClick="ShelfCards_ItemClick"
                              KeyDown="OpenShelfGrid_KeyDown"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                    <StackPanel x:Name="PagerPanel"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">
                        <Button x:Name="PreviousPageButton"
                                Content="Previous"
                                MinWidth="96"
                                Style="{StaticResource AppQuietButtonStyle}"
                                Click="PreviousPage_Click"
                                IsEnabled="False" />
                        <TextBlock x:Name="PageStatus"
                                   MinWidth="216"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppMutedTextBrush}" />
                        <Button x:Name="NextPageButton"
                                Content="Next"
                                MinWidth="96"
                                Style="{StaticResource AppQuietButtonStyle}"
                                Click="NextPage_Click"
                                IsEnabled="False" />
                    </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="FirstLoadTakeover"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Opacity="1"
              Background="{StaticResource AppCanvasBrush}"
              IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
                <TextBlock Text="TVIVO"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AppTextBrush}"
                           FontSize="42"
                           FontWeight="Bold"
                           CharacterSpacing="80" />
                <ProgressRing IsActive="True"
                              Width="36"
                              Height="36"
                              HorizontalAlignment="Center"
                              Foreground="{StaticResource AppAccentBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
