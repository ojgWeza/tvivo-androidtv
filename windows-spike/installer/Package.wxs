<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="$(var.TvivoProductName)"
           Manufacturer="Tvivo"
           Version="$(var.TvivoVersion)"
           UpgradeCode="$(var.TvivoUpgradeCode)"
           Scope="perUser"
           Language="1033"
           InstallerVersion="500"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Tvivo is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="TVIVO_DELETE_DATA" Value="0" Secure="yes" />
    <Property Id="ARPPRODUCTICON" Value="TvivoIcon" />
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw" />
    </Property>
    <Property Id="VCRUNTIME_INSTALLED">
      <RegistrySearch Root="HKLM"
                      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                      Name="Installed"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR WINDOWSBUILDNUMBER &gt;= $(var.TvivoMinBuild)"
            Message="Tvivo requires $(var.TvivoMinOsName) or later." />
    <Launch Condition="Installed OR VCRUNTIME_INSTALLED"
            Message="Tvivo requires the x64 Microsoft Visual C++ 2015–2022 Redistributable. Install it from https://aka.ms/vs/17/release/vc_redist.x64.exe, then run Tvivo setup again. This per-user installer cannot install the shared runtime or request administrator access." />

    <Icon Id="TvivoIcon" SourceFile="$(var.PayloadDir)\Assets\Tvivo.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="TVIVOPROGRAMSFOLDER" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.TvivoInstallDir)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPLICATIONPROGRAMSFOLDER" Name="$(var.TvivoProductName)">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="TvivoStartMenuShortcut"
                    Name="$(var.TvivoProductName)"
                    Description="Browse your Tvivo library"
                    Target="[INSTALLFOLDER]Tvivo.App.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="TvivoIcon" />
          <RegistryValue Root="HKCU"
                         Key="Software\$(var.TvivoInstallDir)"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="TvivoFeature" Title="Tvivo" Level="1">
      <Files Include="$(var.PayloadDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
