<Project Sdk="WixToolset.Sdk/5.0.2">
  <Import Project="..\Version.props" />
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- Default = Windows 11 edition. TvivoWin10=true builds a separate, side-by-side package. -->
    <TvivoEdition>Win11</TvivoEdition>
    <TvivoUpgradeCode>DE41D078-AB21-4CD3-8F5A-85D5C14B5992</TvivoUpgradeCode>
    <TvivoProductName>Tvivo</TvivoProductName>
    <TvivoInstallDir>Tvivo</TvivoInstallDir>
    <TvivoMinBuild>22621</TvivoMinBuild>
    <TvivoMinOsName>Windows 11 build 22621</TvivoMinOsName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TvivoWin10)' == 'true'">
    <TvivoEdition>Win10</TvivoEdition>
    <TvivoUpgradeCode>7B3C5E0A-4D62-4F1B-9A87-2C6E1D90F4A3</TvivoUpgradeCode>
    <TvivoProductName>Tvivo (Windows 10)</TvivoProductName>
    <TvivoInstallDir>Tvivo Win10</TvivoInstallDir>
    <TvivoMinBuild>19041</TvivoMinBuild>
    <TvivoMinOsName>Windows 10 version 2004 (build 19041)</TvivoMinOsName>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);TvivoVersion=$(TvivoVersion);PayloadDir=$(PayloadDir);TvivoUpgradeCode=$(TvivoUpgradeCode);TvivoProductName=$(TvivoProductName);TvivoInstallDir=$(TvivoInstallDir);TvivoMinBuild=$(TvivoMinBuild);TvivoMinOsName=$(TvivoMinOsName)</DefineConstants>
    <OutputName Condition="'$(TvivoEdition)' == 'Win10'">Tvivo-$(TvivoVersion)-win10-x64</OutputName>
    <OutputName Condition="'$(TvivoEdition)' != 'Win10'">Tvivo-$(TvivoVersion)-x64</OutputName>
    <SignOutput Condition="'$(SignOutput)' == ''">false</SignOutput>
    <SuppressIces>ICE03;ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
  <Target Name="SignMsi" Condition="'$(SignOutput)' == 'true'">
    <Error Condition="'$(SignToolPath)' == ''" Text="Set SignToolPath to enable MSI signing." />
    <Exec Command="&quot;$(SignToolPath)&quot; sign /fd SHA256 /a &quot;%(SignMsi.FullPath)&quot;" />
  </Target>
</Project>
